    if flStop(myRun) then return false end
    local t0 = os.clock()
    while os.clock() - t0 < 0.5 do
        if not hrp.Parent or flStop(myRun) then return false end
        local d = dest - hrp.Position
        if (d * FL_FLAT).Magnitude <= 1.5 and math.abs(d.Y) <= 2.5 then break end
