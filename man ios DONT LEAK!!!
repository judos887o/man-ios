						end
					end
				end
				task.wait(2)
			end
			for m in pairs(tracked) do drop(m) end
		end)
		function api.set(on)
			api.on = on and true or false
			if api.on then
				fullScan()
			else
				for m in pairs(tracked) do drop(m) end
			end
		end
		if api.on then task.delay(2, fullScan) end
		return api
	end)()
