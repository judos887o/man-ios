    local function sProp(ch, key)
        if type(ch) ~= "table" or key == nil then return nil end
        local ct = rawget(ch, "CacheTable")
        if type(ct) ~= "table" then
            local okC, c2 = pcall(function() return ch.CacheTable end)
            if okC and type(c2) == "table" then ct = c2 end
        end
        if type(ct) ~= "table" then return nil end
        local v = rawget(ct, key)
        if v ~= nil then return v end
        local okV, v2 = pcall(function() return ct[key] end)
        if okV then return v2 end
        return nil
    end
    if type(rawget(_G, "sProp")) ~= "function" then _G.sProp = sProp end

    local CH_OF = setmetatable({}, { __mode = "k" })
    local function chanForPlot(plot)
        local reg = findReg()
        if type(reg) ~= "table" or not plot then return nil end
        local name = plot.Name
        local ch = rawget(reg, name)
        if type(ch) == "table" then return ch end
        local c = CH_OF[plot]
        if c and rawget(reg, c[1]) == c[2] then return c[2] end
        local ord = plot:GetAttribute("Order")
        for k, v in next, reg do
            if type(v) == "table" then
                local hit = ord ~= nil and tostring(k) == tostring(ord)
                if not hit then
                    local ct = rawget(v, "CacheTable")
                    if type(ct) == "table" then
                        local pn, pl = rawget(ct, "PlotName"), rawget(ct, "Plot")
                        hit = pn == name or pl == plot or pl == name
                    end
                end
                if hit then
                    CH_OF[plot] = { k, v }
                    return v
                end
            end
        end
        return nil
    end

