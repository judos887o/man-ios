local function _faceSmooth(hrp, dir, maxT, rate)
    if not hrp or not hrp.Parent then return end
    local wantY = math.atan2(-dir.X, -dir.Z)
    local t0 = os.clock()
    local last = t0
    while os.clock() - t0 < (maxT or 0.6) do
        if not hrp.Parent then return end
        local now = os.clock()
        local dt = math.clamp(now - last, 1 / 120, 0.1)
        last = now
        local _, y = hrp.CFrame:ToEulerAnglesYXZ()
        local d = (wantY - y + math.pi) % (2 * math.pi) - math.pi
        if math.abs(d) < 0.04 then return end
        local r = rate or tonumber(_G.SMKTRealTurn) or 7
        local step = math.clamp(d, -r * dt, r * dt)
        hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, y + step, 0)
        hrp.AssemblyAngularVelocity = Vector3.zero
        RunService.Heartbeat:Wait()
    end
end
local function goToBrainrot(petPos, slot, allowWhileCarrying, noSnap)
