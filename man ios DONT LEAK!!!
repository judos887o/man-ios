        if requiring then return nil end
        local now = os.clock()
        if not (syncInst and syncInst.Parent) then
            if now - lastInstTry < 0.1 then return nil end
            lastInstTry = now
            local pk = ReplicatedStorage:FindFirstChild("Packages")
            syncInst = pk and pk:FindFirstChild("Synchronizer")
            if not syncInst then
                D.modul = "missing"
                return nil
            end
        end
        D.modul = "ok"
        local ready = #SH.handlers > 0 or _smktGameReady or game:IsLoaded()
        if not ready and now - lastModTry >= 0.25 then
            lastModTry = now
            ready = _smktModuleLoaded(syncInst)
        end
        if not ready then
            D.require = "waiting for the game"
            return nil
        end
        requiring = true
        local inst = syncInst
        task.spawn(function()
            local reqs = {}
            pcall(function()
                local r = getrenv().require
                if type(r) == "function" then reqs[#reqs + 1] = r end
            end)
            reqs[#reqs + 1] = _smktRealRequire
            local err = "no require"
            for _, req in ipairs(reqs) do
                local ok, mod = pcall(req, inst)
                if ok and type(mod) == "table" then
                    syncMod = mod
                    D.require = "ok"
                    requiring = false
                    return
                end
                err = tostring(mod)
            end
            D.require = "error: " .. string.sub(err, 1, 80)
            requiring = false
        end)
        return syncMod
    end

    local envOf = nil
    local function viaEnv(mod)
        if not envOf then
            local getFn = rawget(mod, "Get")
            local gf = getfenv or (debug and debug.getfenv)
            if type(getFn) ~= "function" then D.getfenv = "no Get"; return nil end
            if type(gf) ~= "function" then D.getfenv = "missing"; return nil end
            local ok, env = pcall(gf, getFn)
            if not ok or type(env) ~= "table" then D.getfenv = "error"; return nil end
            envOf = env
        end
        local ch = rawget(envOf, "Channels")
        if type(ch) ~= "table" then D.getfenv = "no Channels"; return nil end
        D.getfenv = isReg(ch) and "ok" or "empty"
        return ch
    end

    local function viaUpvalues(mod)
        if type(GUS) ~= "function" and type(GU1) ~= "function" then
            D.upvalues = "missing"
            return nil
        end
        local seen = {}
        for _, v in next, mod do
            if type(v) == "function" then
                local r = regFromFn(v, 1, seen)
                if r then D.upvalues = "ok"; return r end
            end
        end
        D.upvalues = "nothing"
        return nil
    end

    local gcTries, gcIdx, lastForce = 0, 0, -1
    local function gcScan(force)
        if type(filtergc) ~= "function" or REG_FULL then return false end
        local now = os.clock()
        if gcTries >= 150 then return false end
        if force then
            if now - lastForce < 0.1 then return false end
            lastForce = now
        else
            local la = rawget(_G, "__SXE_LoadedAt")
            local gap = (gcTries >= 60) and 2 or ((type(la) == "number") and 0.25 or 1)
            if now - (tonumber(SH.lastGc) or 0) < gap then return false end
        end
        livePlots()
        local keys = KEYS
        if #keys == 0 then return false end
        SH.lastGc = now
        gcTries += 1
        gcIdx = gcIdx % #keys + 1
        local ok, res = pcall(filtergc, "table", { Keys = { keys[gcIdx] } }, false)
        if not ok then D.filtergc = "error"; return false end
        if type(res) == "table" then
            for _, t in ipairs(res) do
                if offer(t, "filtergc") then D.filtergc = "ok"; return true end
            end
        end
        D.filtergc = "nothing (" .. gcTries .. "x)"
        return false
    end

    local function checkCheap()
        if REG_FULL then return true end
        local lb = viaLobby()
        if lb and offer(lb, "Loader") then return true end
        local t, tsrc = viaGlobals()
        if t and offer(t, tsrc) then return true end
        if REG and offer(REG, REG_SRC or "?") then return true end
        for _, h in ipairs(SH.handlers) do
            local r = regFromFn(h, 2, {})
            if r and offer(r, "Remote") then return true end
        end
        local mod = getModule()
        if mod then
            local e = viaEnv(mod)
            if e then
                if offer(e, "getfenv") then return true end
                if not REG then REG, REG_SRC = e, "getfenv" end
            end
            local u = viaUpvalues(mod)
            if u and offer(u, "Upvalues") then return true end
        end
        if CAND and os.clock() - CAND.at > 0.5 then
            if hasPlotChans(CAND.t) then
                adopt(CAND.t, CAND.src)
                return true
            end
            if os.clock() - CAND.at > 10 then CAND = nil end
        end
        return false
    end

    local function fnSource(fn)
        local ok, s = pcall(function()
            if DINFO then return DINFO(fn, "s") end
            if debug and debug.getinfo then return debug.getinfo(fn).source end
            return nil
        end)
        return (ok and type(s) == "string") and string.lower(s) or ""
    end
    local function isSyncFn(fn, depth, seen)
        if type(fn) ~= "function" or seen[fn] then return false end
        seen[fn] = true
        if string.find(fnSource(fn), "synchron", 1, true) then return true end
        if depth > 0 then
            for _, v in pairs(upvals(fn)) do
                if type(v) == "function" and isSyncFn(v, depth - 1, seen) then return true end
            end
        end
        return false
    end
    local RPRIO, RREST, RST = { pos = 0 }, { pos = 0 }, {}
    local packetConns = {}
    local onPacket
    local function addRemote(o)
        if RST[o] then return end
        local ok, is = pcall(function()
            return o:IsA("RemoteEvent") or o.ClassName == "UnreliableRemoteEvent"
        end)
        if not (ok and is) then return end
        RST[o] = { next = 0, tries = 0 }
        local full = ""
        pcall(function() full = string.lower(o:GetFullName()) end)
        local list = string.find(full, "sync", 1, true) and RPRIO or RREST
        list[#list + 1] = o
    end
    local collected = false
    local listenConns = {}
    local function collectRemotes()
        local pk = ReplicatedStorage:FindFirstChild("Packages")
        if not pk then return end
        collected = true
        for _, o in ipairs(pk:GetDescendants()) do addRemote(o) end
        pcall(function() listenConns[#listenConns + 1] = pk.DescendantAdded:Connect(addRemote) end)
        local function two(a)
            addRemote(a)
            if a ~= pk then
                for _, b in ipairs(a:GetChildren()) do addRemote(b) end
            end
        end
        for _, a in ipairs(ReplicatedStorage:GetChildren()) do two(a) end
        pcall(function() listenConns[#listenConns + 1] = ReplicatedStorage.ChildAdded:Connect(two) end)
    end
    local PACKETS = 0
    local function checkRemote(o, st, now)
        st.tries += 1
        local ok, conns = pcall(getconnections, o.OnClientEvent)
        if not ok or type(conns) ~= "table" then
            st.next = math.huge
            return
        end
        local found = false
        for _, c in ipairs(conns) do
            local okF, fn = pcall(function() return c.Function end)
            if okF and type(fn) == "function" then
                local mine = false
                if type(ISEXEC) == "function" then
                    local okE, r = pcall(ISEXEC, fn)
                    mine = okE and r == true
                end
                if not mine and isSyncFn(fn, 2, {}) then
                    local dup = false
                    for _, h in ipairs(SH.handlers) do
                        if h == fn then dup = true; break end
                    end
                    if not dup then SH.handlers[#SH.handlers + 1] = fn end
                    found = true
                end
            end
        end
        if found then
            st.next = math.huge
            D.remote = "ok (" .. #SH.handlers .. ")"
            local okC, cn = pcall(function()
                return o.OnClientEvent:Connect(function()
                    PACKETS += 1
                    if not REG_FULL then task.defer(onPacket) end
                end)
            end)
            if okC and cn then packetConns[#packetConns + 1] = cn end
        elseif #conns == 0 then
            st.next = (st.tries < 60) and (now + 0.25) or math.huge
        else
            st.next = (st.tries < 4) and (now + 1) or math.huge
        end
    end
    local ME = {}
    local function remoteStep(budget)
        if type(getconnections) ~= "function" then
            D.remote = "missing"
            return
        end
        local now0 = os.clock()
        if SH.remoteOwner ~= ME and (tonumber(SH.remoteBusyUntil) or 0) > now0 then return end
        SH.remoteOwner, SH.remoteBusyUntil = ME, now0 + 0.5
        if not collected then collectRemotes() end
        local now, used = os.clock(), 0
        for _, list in ipairs({ RPRIO, RREST }) do
            local n = #list
            for i = 1, n do
                local idx = (list.pos + i - 1) % n + 1
                local o = list[idx]
                local st = RST[o]
                if st and now >= st.next then
                    checkRemote(o, st, now)
                    used += 1
                    if used >= budget then
                        list.pos = idx
                        return
                    end
                end
            end
        end
        if #SH.handlers == 0 then D.remote = "searching (" .. (#RPRIO + #RREST) .. " remotes)" end
    end
    onPacket = function()
        if REG_FULL then return end
        if checkCheap() then return end
        gcScan(true)
    end

    local function findReg()
        if REG_FULL then return REG end
        local lb = viaLobby()
        if lb and offer(lb, "Loader") then return REG end
