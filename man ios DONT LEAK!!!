			local ch = chans[plot.Name]
			if not ch then
				local ord = plot:GetAttribute("Order")
				if ord then ch = chans["Plot" .. tostring(ord)] end
			end
			if ch then
				local ct = rawget(ch, "CacheTable") or ch.CacheTable
				if ct and ct.Owner then
					local o = ct.Owner
					if typeof(o) == "Instance" and o:IsA("Player") then return o.Name end
					if type(o) == "number" then
						local p = Players:GetPlayerByUserId(o)
						if p then return p.Name end
					end
					if type(o) == "string" and o ~= "" then return o end
				end
			end
		end

		local sign = plot:FindFirstChild("PlotSign")
		if not sign then return nil end
		local gui = sign:FindFirstChildWhichIsA("SurfaceGui", true)
		if not gui then return nil end
		for _, lbl in ipairs(gui:GetDescendants()) do
			if lbl:IsA("TextLabel") and lbl.Text and lbl.Text ~= "" and lbl.Text ~= "Empty Base" then
