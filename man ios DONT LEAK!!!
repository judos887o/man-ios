						_radCap = math.max(10, math.min(_radCap or math.huge, firstBd * 0.8))
					end
				end
				if mode == "arm" and firstBd > _armProven + 3 then
					_armFail += 1
					_unexp = 0
					_armFailMin = math.min(_armFailMin, firstBd)
					_armCap = math.clamp(firstBd - 5, ARM_MIN, ARM_MAX)
				elseif tr == "hold" then
