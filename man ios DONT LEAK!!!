			local s = Instance.new("Sound")
			s.Name = "SMKTPrioJoin"
			s.SoundId = SOUND_ID
			s.Volume = tonumber(G.SMKT_PrioJoinVolume) or 1
			s.Parent = game:GetService("SoundService")
			s:Play()
			pcall(function() s.Ended:Connect(function() s:Destroy() end) end)
			task.delay(20, function() if s.Parent then s:Destroy() end end)
		end)
	end
	_G.SMKTPlayPrioJoinSound = playJoinSound
	local function ownerMatches(owner, plr)
		if owner == nil then return false end
		if owner == plr then return true end
		local t = typeof(owner)
		if t == "Instance" then return owner.Name == plr.Name end
		if t == "number" then return owner == plr.UserId end
		if t == "string" then return owner == plr.Name or owner == plr.DisplayName or owner == tostring(plr.UserId) end
		if t == "table" then
			local u = rawget(owner, "UserId")
			local n = rawget(owner, "Name")
			return (u ~= nil and u == plr.UserId) or (n ~= nil and n == plr.Name)
		end
		return false
	end
	local function plotOwner(plotName)
		local o = nil
		local lb = rawget(G, "Lobby")
		local d = type(lb) == "table" and rawget(lb, tostring(plotName)) or nil
		if type(d) == "table" then o = rawget(d, "Owner") end
		if o == nil and type(_G.TT3SyncGet) == "function" then
			pcall(function()
				local ch = _G.TT3SyncGet(tostring(plotName))
				local ct = ch and rawget(ch, "CacheTable")
				if type(ct) == "table" then o = ct.Owner end
			end)
		end
		return o
	end
	local function insideAnyBase(pos)
		local pf = workspace:FindFirstChild("Plots")
		if not pf then return false end
		for _, p in ipairs(pf:GetChildren()) do
			local ok, cf, size = pcall(function() return p:GetBoundingBox() end)
			if ok and cf and size and size.Magnitude < 500 then
				local l = cf:PointToObjectSpace(pos)
				if math.abs(l.X) <= size.X * 0.5 and math.abs(l.Z) <= size.Z * 0.5 and math.abs(l.Y) <= size.Y * 0.5 + 6 then return true end
			end
		end
		return false
	end
	local function isFree()
		local c = LPj.Character
		local hum = c and c:FindFirstChildOfClass("Humanoid")
		local hrp = c and c:FindFirstChild("HumanoidRootPart")
		if not hum or not hrp or hum.Health <= 0 then return false, "tot" end
		if LPj:GetAttribute("Stealing") then return false, "currently stealing" end
		local rl = 0
		if type(_G.SMKTRagdollLeft) == "function" then pcall(function() rl = _G.SMKTRagdollLeft() end) end
		local st = hum:GetState()
		if rl > 0 or st == Enum.HumanoidStateType.Ragdoll or st == Enum.HumanoidStateType.FallingDown or st == Enum.HumanoidStateType.Physics then return false, "ragdoll" end
		if _G.SMKTIsTeleporting == true or type(_G.SMKTFlashBusy) == "number" then return false, "tp running" end
		if insideAnyBase(hrp.Position) then return false, "in einer base" end
		return true, nil
	end
	_G.SMKTPrioJoinFree = isFree
	Players.PlayerAdded:Connect(function(plr)
		if plr ~= LPj then joinAt[plr] = os.clock() end
	end)
	Players.PlayerRemoving:Connect(function(plr)
		joinAt[plr] = nil
		handled[plr] = nil
	end)
	task.spawn(function()
		while _G.SMKT_CurInst == SMKT_INST do
			task.wait(0.5)
			local now = os.clock()
			local any = false
			for plr, t in pairs(joinAt) do
				if now - t > 120 or (handled[plr] and handled[plr].done) then joinAt[plr] = nil else any = true end
			end
			if any and type(_G.SMKTScanForTP) == "function" then
				local ok, pets = pcall(_G.SMKTScanForTP)
				if ok and type(pets) == "table" then
					for plr in pairs(joinAt) do
						local best = nil
						for _, p in ipairs(pets) do
							if p._pri and p.plot ~= nil and not p.beingStolen and ownerMatches(plotOwner(p.plot), plr) then
								if not best or p._pri < best._pri then best = p end
							end
						end
						if best then
							local h = handled[plr]
							if not h then
								h = { at = now }
								handled[plr] = h
								playJoinSound()
								note(string.format("%s joined with %s", plr.DisplayName or plr.Name, tostring(best.name)))
							end
							if G.SMKT_AutoTPPrioJoin == false or now - h.at > 20 then
								h.done = true
							else
								local free, why = isFree()
								if free then
									h.done = true
									_G.TT3StealTargetUID = tostring(best.plot) .. "_" .. tostring(best.slot)
									_G.TT3StealTarget = best
									_G.TT3TPSyncActive = true
									local gen = (_G._TT3TPSyncGen or 0) + 1
									_G._TT3TPSyncGen = gen
									task.delay(12, function()
										if _G._TT3TPSyncGen == gen then
											_G.TT3TPSyncActive = false
											_G.TT3StealTargetUID = nil
											_G.TT3StealTarget = nil
										end
									end)
									note("Auto-TP to " .. tostring(best.name))
									if type(_G.SXE_FlowerDoTP) == "function" then task.spawn(_G.SXE_FlowerDoTP) end
								elseif h.why ~= why then
									h.why = why
								end
							end
						end
					end
				end
			end
		end
	end)
end)()
end)

