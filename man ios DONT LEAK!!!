local _flLog, _flDirty = {}, false
local function flMark(s)
    _flLog[#_flLog + 1] = string.format("%s %.2f %s", os.date("%H:%M:%S"), os.clock(), tostring(s))
    if #_flLog > 150 then table.remove(_flLog, 1) end
    if _flDirty or type(writefile) ~= "function" then return end
    _flDirty = true
    task.delay(0.5, function()
        _flDirty = false
        pcall(writefile, "smkt_flash_trace.txt", table.concat(_flLog, "\n"))
    end)
end
_G.SMKTFlashMark = flMark
local function flPing()
    local ok, p = pcall(function() return LP:GetNetworkPing() end)
    p = ok and tonumber(p) or 0.1
    if p ~= p or p < 0 then p = 0.1 end
    return math.min(p, 1)
end

local function flChar()
    local c = LP.Character
    local h = c and c:FindFirstChild("HumanoidRootPart")
    local hum = c and c:FindFirstChildOfClass("Humanoid")
    return c, h, hum
end
local function flTool()
    local c = LP.Character
    local t = c and c:FindFirstChild("Flash Teleport")
    if t and t:IsA("Tool") then return t end
    local bp = LP:FindFirstChildOfClass("Backpack")
    t = bp and bp:FindFirstChild("Flash Teleport")
    if t and t:IsA("Tool") then return t end
    return nil
end
local _flCdLen = FL_COOLDOWN
local function flLeft(tool)
    local now = workspace:GetServerTimeNow()
    local ct = tool:GetAttribute("CooldownTime")
    local cu = tool:GetAttribute("CooldownUntil")
    local hasAttr = type(ct) == "number" or type(cu) == "number"
    local left, src = 0, "attr"
    if type(ct) == "number" and ct > 0 then left = ct end
    if type(cu) == "number" then
        left = math.max(left, cu - now)
        if _flLastFire > -math.huge and cu > _flLastFire + 1 and now - _flLastFire < 6 then
            _flCdLen = math.clamp(cu - _flLastFire, 2, 60)
        end
    end
    if _flLastFire > -math.huge then
        local covered = type(cu) == "number" and cu > _flLastFire + 1
        if not hasAttr or (not covered and now - _flLastFire < 1.5) then
            local est = _flLastFire + _flCdLen - now
            if est > left then left, src = est, "est" end
        end
    end
    return math.max(0, left), src
end
local function flRemote(maxWait)
    if type(_G.SMKT_SpoofReset) == "function" then
        _G.SMKT_SpoofReset("RemoteFunction|Tools/Flash/Activate")
    end
    local f = _genv.SMKT_NetFunctionNow
    if type(f) ~= "function" then return nil end
    local untilT = os.clock() + (maxWait or 0)
    while true do
        local ok, rf = pcall(f, "Tools/Flash/Activate")
        if ok and typeof(rf) == "Instance" and rf.Parent then return rf end
        if os.clock() >= untilT then return nil end
        task.wait(0.1)
    end
end

local flRay = RaycastParams.new()
flRay.FilterType = Enum.RaycastFilterType.Exclude
flRay.IgnoreWater = true
flRay.RespectCanCollide = true
pcall(function() flRay.CollisionGroup = "Player" end)
local function flSkip()
    local list = _flCS:GetTagged("FlashTeleportIgnore")
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then list[#list + 1] = p.Character end
    end
    flRay.FilterDescendantsInstances = list
end
local function flHit(cf, size, dir)
    local k
    local r = workspace:Blockcast(cf, size, dir, flRay)
    if r then k = r.Distance end
    local m = workspace:Raycast(cf.Position, dir, flRay)
    if m and (not k or m.Distance < k) then k = m.Distance end
    if (dir * FL_FLAT).Magnitude > 0.001 then
        local n = math.max(size.X, size.Y, size.Z)
        local o = dir.Unit * n
        local q = workspace:Blockcast(cf - o, size, dir + o, flRay)
        if q then
            local rr = math.max(0, q.Distance - n)
            if not k or rr < k then k = rr end
        end
    end
    return k
end
local function flCompute(h)
    local i, j, k = h.Distance, h.RootSize, h.HipHeight
    local l = h.RootCFrame * CFrame.new(0, -(k + j.Y * 0.5), 0)
    local m = h.CameraCFrame * CFrame.fromOrientation(FL_PITCH, 0, 0)
    local n = CFrame.lookAlong(l.Position, m.LookVector)
    local o = math.sqrt(j.X ^ 2 + j.Z ^ 2)
    local q = Vector3.new(o, k + j.Y, o)
    local r = CFrame.new(0, q.Y * 0.5, 0)
    local s, t = n * CFrame.new(0, 0, -i), -math.huge
    local function consider(u)
        local v = ((n.Position - u.Position) * FL_FLAT).Magnitude
        if t < v then t, s = v, u end
    end
    flSkip()
    local u = n * CFrame.new(0, 0, -i)
    local v = u.Position - n.Position
    local w = flHit(n * r, q, v)
    if w then
        consider(CFrame.new(n.Position + v.Unit * w) * u.Rotation)
        for _, y in ipairs({ q.Y * 0.25, q.Y * 0.5, q.Y, q.Y * 1.25, q.Y * 1.5, q.Y * 2, 0.5, 1, 2.5, 5 }) do
            local z = n
            for _, B in ipairs({ CFrame.new(0, y, 0), CFrame.new(0, 0, -i), CFrame.new(0, -y, 0) }) do
                local C = z * B
                local D = C.Position - z.Position
                local E = flHit(z * r, q, D)
                z = E and (CFrame.new(z.Position + D.Unit * E) * C.Rotation) or C
                consider(z)
            end
        end
    else
        consider(u)
    end
    local _, yaw = s:ToOrientation()
    return { CFrame = CFrame.new(s.Position) * CFrame.fromOrientation(0, yaw, 0), Valid = math.max(2, o) <= t }
end
local function flVirtual(dir)
    local c = LP.Character
    local head = c and c:FindFirstChild("Head")
    local root = c and c.PrimaryPart
    local hum = c and c:FindFirstChildWhichIsA("Humanoid")
    if not head or not head:IsA("BasePart") or not root or not hum then return nil end
    local m = {
        RootCFrame = root.CFrame, RootSize = root.Size, HipHeight = hum.HipHeight,
        CameraCFrame = CFrame.lookAlong(head.Position - dir * 12, dir), Distance = FL_DIST,
    }
    local ok, res = pcall(flCompute, m)
    if ok and type(res) == "table" then return { Params = m, Result = res } end
    return nil
end

local flFloor = RaycastParams.new()
flFloor.FilterType = Enum.RaycastFilterType.Exclude
local flOver = OverlapParams.new()
flOver.FilterType = Enum.RaycastFilterType.Exclude
pcall(function() flOver.RespectCanCollide = true end)
local function flRefresh()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then list[#list + 1] = p.Character end
    end
    flFloor.FilterDescendantsInstances = list
    flOver.FilterDescendantsInstances = list
end
local function flLift()
    local _, h, hum = flChar()
    if not h or not hum then return 3 end
    return hum.HipHeight + h.Size.Y * 0.5
end
local function flUsable(pos)
    local ok, parts = pcall(function() return workspace:GetPartBoundsInBox(CFrame.new(pos), FL_BODY, flOver) end)
    if ok and type(parts) == "table" then
        for _, p in ipairs(parts) do
            if p.CanCollide then return false end
        end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        local r = p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
        if r and ((r.Position - pos) * FL_FLAT).Magnitude < 3 then return false end
    end
    return true
end
local function flStandWorld(cf, e)
    local j = cf:PointToWorldSpace(Vector3.new(e[1], FL_Y, e[2]))
    local k = workspace:Raycast(j + Vector3.new(0, 2, 0), Vector3.new(0, -8, 0), flFloor)
    if not k or k.Normal.Y < 0.95 then return nil, nil end
    return k.Position + Vector3.new(0, flLift(), 0), cf:VectorToWorldSpace(Vector3.new(e[3], e[4], e[5])).Unit
end
local function flPickStand(plot, slots, hrp)
    local list = _FLASH_STANDS[plot:GetAttribute("Order")]
    local mr = plot:FindFirstChild("MainRoot")
    if not list or not mr or not mr:IsA("BasePart") then return nil, nil end
    local cf = mr.CFrame
    local o = cf:PointToObjectSpace(hrp.Position)
    local q = {}
    for _, s in ipairs(slots) do
        for _, u in ipairs(list[s] or {}) do
            q[#q + 1] = { u, (u[1] - o.X) ^ 2 + (u[2] - o.Z) ^ 2 }
        end
    end
    table.sort(q, function(a, b) return a[2] < b[2] end)
    for _, it in ipairs(q) do
        local p, d = flStandWorld(cf, it[1])
        if p and flUsable(p) then return p, d end
    end
    return nil, nil
end
local function flBlue(pos)
    local sx, n = 0, 0
    local pf = workspace:FindFirstChild("Plots")
    for _, pl in ipairs(pf and pf:GetChildren() or {}) do
        local mr = pl:FindFirstChild("MainRoot")
        if mr and mr:IsA("BasePart") then sx += mr.Position.X; n += 1 end
    end
    return pos.X >= (n > 0 and sx / n or -409.6)
end
local function flInside(box, pos)
    local p = box.CFrame:PointToObjectSpace(pos)
    local h = box.Size * 0.5
    return math.abs(p.X) <= h.X and math.abs(p.Y) <= h.Y + 3 and math.abs(p.Z) <= h.Z
end
local function flHoldCam(dir)
    local cam = workspace.CurrentCamera
    if not cam then return function() end end
    local oldType = cam.CameraType
    local conn = RunService.RenderStepped:Connect(function()
        local head = LP.Character and LP.Character:FindFirstChild("Head")
        if head then
            cam.CameraType = Enum.CameraType.Scriptable
            cam.CFrame = CFrame.lookAlong(head.Position - dir * 12, dir)
        end
    end)
    return function()
        conn:Disconnect()
        cam.CameraType = oldType
        local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if hum then cam.CameraSubject = hum end
    end
