	local function _isPlayerStillInGame(owner)
		if not owner or owner == 0 or owner == "" then return false end
		if typeof(owner) == "Instance" and owner:IsA("Player") then
			return owner.Parent == Players
		end
		if type(owner) == "number" then
			return Players:GetPlayerByUserId(owner) ~= nil
		end
		if type(owner) == "string" then
			local low = owner:lower()
			for _, p in ipairs(Players:GetPlayers()) do
				if p.Name:lower() == low or p.DisplayName:lower() == low then
					return true
				end
			end
			return false
		end
		if type(owner) == "table" then
			local uid = owner.UserId or owner.userId
			if uid and Players:GetPlayerByUserId(uid) then return true end
			if owner.Name and Players:FindFirstChild(owner.Name) then return true end
		end
		return false
	end

	local function _podiumStillHasPet(podium)
