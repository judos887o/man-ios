			end
			local ch = LP.Character
			local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
			if not hrp then return end
			local r = math.clamp(tonumber(Hub.State.autoBuyRange) or 17, 5, 50)
			ring(hrp, r)
			local hp = hrp.Position
			local now = os.clock()
			local minG = math.max(0, tonumber(M.buyMinGen) or 0) * 1e6
			table.clear(cands)
			for p in pairs(set) do
				if not p.Parent then
					set[p] = nil
					state[p] = nil
					continue
				end
				local st = state[p]
				local owner = nil
				if st then
					owner = p:GetAttribute("TargetPlayer")
					if st.owner ~= owner then
						local was = st.owner
						st.owner = owner
						st.tries = 0
						st.nextAt = 0
						if owner == myId then
							trace("BOUGHT " .. tostring(st.name))
							if st.firedAt and now - st.firedAt < 5 then api.bought(st.name) end
						elseif was == myId then
							trace("LOST " .. tostring(st.name) .. " to " .. tostring(owner))
						end
					end
				end
				local pos = posOf(p)
				if not pos then continue end
				local d = (pos - hp).Magnitude
