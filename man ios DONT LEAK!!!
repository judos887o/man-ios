	local function runScanCycle()
		local results = scan()
		getgenv().SMKT_ScanCount = #results
		lastResults = results

		local _pfNow = Workspace:FindFirstChild("Plots")
		for _, r in ipairs(results) do
			if r.pos then _posCache[r.uid] = r.pos
			elseif _posCache[r.uid] then
				if r.plot and ((_pfNow and _pfNow:FindFirstChild(tostring(r.plot))) or (_G.SXE_FindPlot and _G.SXE_FindPlot(r.plot))) then r.pos = _posCache[r.uid] else _posCache[r.uid] = nil end
			end
		end
		do
			local _top = results[1]
			getgenv().SMKT_TopPlot = (_top and _top.plot ~= nil) and tostring(_top.plot) or nil
			getgenv().SMKT_TopName = _top and _top.name or nil
		end

		if not getgenv().SMKT_TargetReady then
			local now = os.clock()
			local n = #results
			if n ~= _settleCount then _settleCount = n; _settleChangeAt = now end
			if n > 0 then
				_settleFirstAt = _settleFirstAt or now
				if (_listComplete() and (now - _settleChangeAt) >= 0.15) or (now - _settleFirstAt) >= (tonumber(_G.SMKTSettleMax) or 3) then
					getgenv().SMKT_TargetReady = true
				end
			end
		end

		if _target then
			local freshEntry = nil
			for _, r in ipairs(lastResults) do
				if r.uid == _target.uid then
					freshEntry = r
					break
				end
			end

			if not freshEntry then
				_targetMissCount = _targetMissCount + 1
				if _targetMissCount >= 8 then
					setTarget(nil, nil)
					manualPin = false; getgenv().SMKT_ManualPin = false
					_targetMissCount = 0
				end
			else
				_targetMissCount = 0
				_target = freshEntry
				getgenv().SMKT_SelectedData = freshEntry
				getgenv().SMKT_SelectedUID = freshEntry.uid
				if getgenv().PrioritySystem then getgenv().PrioritySystem.SelectedData = freshEntry end
			end
		end

		pcall(updateGUI, results)

		if manualPin then
			return
		end

		if activeMode == "Nearest" then
			local nearest = pickNearest(lastResults)
			if nearest and (not _target or _target.uid ~= nearest.uid) then
				local rowFrame = findRowFrameByUID(nearest.uid)
				setTarget(nearest, rowFrame)
			end
		elseif activeMode == "Priority" then
			applyPrioritySelection(lastResults)
		end
	end

