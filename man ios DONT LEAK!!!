			local al = data and rawget(data, "AnimalList")
			local podiums = plot:FindFirstChild("AnimalPodiums")
			if not podiums then continue end
			for _, podium in ipairs(podiums:GetChildren()) do
				local n = tonumber(podium.Name)
				if not n then continue end
				local prompt = _podiumPrompt(podium)
				if not prompt then continue end
				local e = type(al) == "table" and (al[n] or al[tostring(n)]) or nil
				if type(e) == "table" and (e.Machine or e.Fusing) then continue end
				local idx = type(e) == "table" and e.Index or nil
				local mut = type(e) == "table" and e.Mutation or nil
				local traits = type(e) == "table" and e.Traits or nil
				local disp
				if idx ~= nil then
					local info = AnimalsData_L and AnimalsData_L[idx]
					if type(info) == "table" and (info.Egg or info.LuckyBlock) then continue end
					disp = (type(info) == "table" and info.DisplayName) or tostring(idx)
				else
					disp = tostring(prompt.ObjectText or "")
					if disp == "" then disp = "Slot " .. n end
				end
				if _isBannedPet(disp) then continue end
				local gen = 0
				if idx ~= nil then
					local ok, g = pcall(_calcGen, idx, mut or "None", type(traits) == "table" and traits or nil)
					if ok and tonumber(g) then gen = tonumber(g) end
					if not _passesMinGen(gen) then continue end
				end
				local stealer = type(e) == "table" and e.Steal or nil
				list[#list + 1] = {
					plot = plot, plotName = plot.Name, slot = n, prompt = prompt,
					name = disp, index = idx, gen = gen, uid = plot.Name .. "_" .. n,
					listed = (type(al) ~= "table") or type(e) == "table",
					beingStolen = (function(s)
						if type(s) ~= "number" or s == LocalPlayer.UserId then return false end
						local pl = game:GetService("Players"):GetPlayerByUserId(s)
						local st = pl and pl:GetAttribute("Stealing")
						return st ~= nil and st ~= false
					end)(stealer),
				}
			end
		end
