			if d:IsA("TextLabel") and d.Visible then
				local t = tostring(d.Text or ""):gsub("<[^>]->", ""):upper()
				if t:find("STOLEN", 1, true) then return true end
			end
		end
		return false
	end

	local _stResetSeen = nil
	local _scanPend, _scanChans = 0, nil
	local _prioSeen = {}
	local function scan()
		local results = {}
		local catalog = {}
		_scanPend, _scanChans = 0, nil

		if not AnimalsData then
			if type(loadData) == "function" then pcall(loadData) end
			if getgenv().GetAD then AnimalsData = getgenv().GetAD() end
		end

		if AnimalsData then
			for idx, info in pairs(AnimalsData) do
				if type(info) == "table" then
					if info.DisplayName then catalog[info.DisplayName:lower()] = idx end
					catalog[tostring(idx):lower()] = idx
				end
			end
		end

		if _G.SMKTSyncResetAt and _G.SMKTSyncResetAt ~= _stResetSeen then
			_stResetSeen = _G.SMKTSyncResetAt
			_xchan = nil
			_syncChannels = nil
		end
		_syncChannels = _G.SabcomRegistry
		if not _syncChannels and type(_stealRegistry) == "function" then
			_syncChannels = _stealRegistry()
		end

		local pf = Workspace:FindFirstChild("Plots")
		local chans = _syncChannels or _G.SabcomRegistry
		if not chans then
			chans = _stealRegistry()
			if chans then _syncChannels = chans end
		end
		_scanChans = chans

		local coveredSlots = {}
		local _matchN, _consumed = {}, {}

		if chans then
			for plotKey, ch in pairs(chans) do
				if type(ch) ~= "table" then continue end
				local owner = readChannel(ch, "Owner")

				if not _isPlayerStillInGame(owner) or ownerIsMe(owner) then continue end

				local al = readChannel(ch, "AnimalList")
				if type(al) ~= "table" then continue end
				local ownerStr = resolveOwner(owner)

				local plotInst = (pf and pf:FindFirstChild(tostring(plotKey))) or (_G.SXE_FindPlot and _G.SXE_FindPlot(plotKey))
				if not plotInst and pf then
					local num = tostring(plotKey):match("^%d+$") or tostring(plotKey):match("^[Pp]lot%s*(%d+)$")
					if num then
						for _, pl in ipairs(pf:GetChildren()) do
							local ord = pl:GetAttribute("Order")
							if (ord and tostring(ord) == num) or pl.Name == num then
								plotInst = pl
								break
							end
						end
					end
				end
				local resolvedPlotName = plotInst and plotInst.Name or tostring(plotKey)
				local podiums = plotInst and plotInst:FindFirstChild("AnimalPodiums")

				for slot, ad in pairs(al) do
					if type(ad) ~= "table" then continue end
					if type(slot) == "string" and tonumber(slot) and rawget(al, tonumber(slot)) ~= nil then continue end
					local idx = ad.Index
					if not idx then continue end
					local info = AnimalsData and AnimalsData[idx]
					if not info or info.Egg or info.LuckyBlock then continue end
					local disp = info.DisplayName or idx
					if tostring(disp):match("^%d+$") then continue end
					if _isBannedPet(disp) then continue end

					local podium = podiums and podiums:FindFirstChild(tostring(slot))
					local beingStolen = (function(s)
						if type(s) ~= "number" or s == LocalPlayer.UserId then return false end
						local pl = game:GetService("Players"):GetPlayerByUserId(s)
						local st = pl and pl:GetAttribute("Stealing")
						return st ~= nil and st ~= false
					end)(ad.Steal)
					if podium and not beingStolen and not _podiumStillHasPet(podium) then
						_scanPend += 1
						continue
					end

					local petObj = nil
					if podium then
						for _, chPart in ipairs(podium:GetChildren()) do
							if chPart:IsA("Model") then petObj = chPart; break end
						end
					end

					local traits = type(ad.Traits) == "table" and ad.Traits or (petObj and getPetTraits(petObj) or {})
					local mut = (ad.Mutation and ad.Mutation ~= "None") and ad.Mutation or (petObj and getPetMutation(petObj) or "None")
					local gen = _sabCalcGen(idx, mut, traits, petObj, podium)

					if not _passesMinGen(gen) then continue end
					local traitStr = (type(traits) == "table" and #traits > 0) and table.concat(traits, ", ") or ""

					coveredSlots[resolvedPlotName .. "_" .. tostring(slot)] = "n|" .. resolvedPlotName .. "|" .. tostring(disp):lower() .. "|" .. tostring(gen)

					table.insert(results, {
						name     = disp,
						gen      = gen,
						genText  = fmt(gen),
						owner    = ownerStr,
						mutation = mut,
						traits   = traits,
						traitStr = traitStr,
						source   = "sync",
						plot     = resolvedPlotName,
						slot     = tostring(slot),
						uid      = "sync:" .. resolvedPlotName .. ":" .. tostring(slot),
						pos      = resolvePlotPosition(plotKey, slot),
						stolen   = beingStolen or _podiumStolen(podium)
					})
				end
			end
		end

		if pf then
			local seen = {}
			local _myVis = rawget(_G, "__SXE_MyPlot")
			if not _myVis then
				for _, plot in ipairs(pf:GetChildren()) do
					if isMyPlotVisual(plot) then _myVis = plot.Name; break end
				end
			end
			for _, plot in ipairs((_G.SXE_AllPlotKids and _G.SXE_AllPlotKids()) or pf:GetChildren()) do
				if plot.Name == _myVis or isMyPlotVisual(plot) then continue end
				local ownerStr, _signEmpty = _visualOwner(plot)
				if _signEmpty then continue end
				if ownerStr then
					if not _isPlayerStillInGame(ownerStr) then continue end
				else
					if not _myVis then continue end
					ownerStr = "?"
				end

				local podiums = plot:FindFirstChild("AnimalPodiums")
				for _, obj in ipairs(plot:GetDescendants()) do
					if not obj:IsA("Model") then continue end
					if seen[obj] then continue end
					local name = obj.Name
					local idx = catalog[name:lower()]
					if not idx then
						local a = obj:GetAttribute("Index") or obj:GetAttribute("Animal")
						if a then idx = catalog[tostring(a):lower()] end
					end
					if not idx then continue end
					local info = AnimalsData and AnimalsData[idx]
					if not info or info.Egg or info.LuckyBlock then continue end
					seen[obj] = true
					local disp = info.DisplayName or idx
					if tostring(disp):match("^%d+$") then continue end
					if _isBannedPet(disp) then continue end

					local podium = nil
					if podiums then
						local curr = obj
						while curr and curr.Parent and curr.Parent ~= podiums and curr.Parent ~= Workspace do
							curr = curr.Parent
						end
						if curr and curr.Parent == podiums then
							podium = curr
						end
					end

					local slotName = podium and tostring(podium.Name) or nil
					if slotName and coveredSlots[tostring(plot.Name) .. "_" .. slotName] then
						local _ck = tostring(plot.Name) .. "_" .. slotName
						local _nk = coveredSlots[_ck]
						if type(_nk) == "string" and not _consumed[_ck] then
							_consumed[_ck] = true
							_matchN[_nk] = (_matchN[_nk] or 0) + 1
						end
						continue
					end

					local traits = getPetTraits(obj)
					local mut = getPetMutation(obj)
					local gen = _sabCalcGen(idx, mut, traits, obj, podium)

					if not _passesMinGen(gen) then continue end
					local traitStr = (type(traits) == "table" and #traits > 0) and table.concat(traits, ", ") or ""
					local okPos, pivot = pcall(function() return obj:GetPivot() end)

					local uniqueUid = (slotName and ("sync:" .. tostring(plot.Name) .. ":" .. slotName)) or getVisualUid(obj)

					if slotName then
						coveredSlots[tostring(plot.Name) .. "_" .. slotName] = true
					end

					table.insert(results, {
						name     = disp,
						gen      = gen,
						genText  = fmt(gen),
						owner    = ownerStr,
						mutation = mut,
						traits   = traits,
						traitStr = traitStr,
						source   = "visual",
						plot     = tostring(plot.Name),
						slot     = slotName,
						uid      = uniqueUid,
						pos      = okPos and pivot and pivot.Position or nil,
						stolen   = _podiumStolen(podium)
					})
				end
			end
		end

		do
			local seen = {}
			local deduped = {}
			local syncN = {}
			local function _nkOf(e)
				if e.plot and e.name and e.gen then
					return "n|" .. tostring(e.plot) .. "|" .. tostring(e.name):lower() .. "|" .. tostring(e.gen)
				end
				return nil
			end
			local function _keyOf(e)
				if e.plot and e.slot then
					return "s|" .. tostring(e.plot) .. "|" .. tostring(e.slot)
				end
				return "u|" .. tostring(e.uid)
			end
			for _, e in ipairs(results) do
				if e.source == "sync" then
					local k = _keyOf(e)
					if not seen[k] then
						seen[k] = true
						local nk = _nkOf(e)
						if nk then syncN[nk] = (syncN[nk] or 0) + 1 end
						deduped[#deduped+1] = e
					end
				end
			end
			for _, e in ipairs(results) do
				if e.source ~= "sync" then
					local k = _keyOf(e)
					if not seen[k] then
						seen[k] = true
						local nk = _nkOf(e)
						if nk and (syncN[nk] or 0) - (_matchN[nk] or 0) > 0 then
							_matchN[nk] = (_matchN[nk] or 0) + 1
						else
							deduped[#deduped+1] = e
						end
					end
				end
			end
			results = deduped
		end

		local priorityIndex = {}
		for i, pname in ipairs(priorityList) do
			local lname = pname:lower()
			if priorityIndex[lname] == nil then priorityIndex[lname] = i end
			local nk = lname:gsub("[%s%-_'%.:+]", "")
			if priorityIndex[nk] == nil then priorityIndex[nk] = i end
		end
		local _newPrio = nil
		for _, e in ipairs(results) do
			local ln = tostring(e.name or ""):lower()
			e._pri = priorityIndex[ln] or priorityIndex[(ln:gsub("[%s%-_'%.:+]", ""))]
			if e._pri then
				local k = tostring(e.uid) .. "|" .. ln
				if not _prioSeen[k] then
					_prioSeen[k] = true
					if not _newPrio or e._pri < _newPrio._pri then _newPrio = e end
				end
			end
		end
		if _newPrio and _G.SXE_PlayPrioSound then
			task.spawn(_G.SXE_PlayPrioSound, tostring(_newPrio.name) .. " (base of " .. tostring(_newPrio.owner or "?") .. ")")
		end

		table.sort(results, function(a, b)
			local pa = a._pri
			local pb = b._pri
			if pa and pb then
				if pa ~= pb then return pa < pb end
			elseif pa and not pb then
				return true
			elseif pb and not pa then
				return false
			end
			if (a.stolen == true) ~= (b.stolen == true) then return b.stolen == true end
			if a.source ~= b.source then return a.source == "sync" end
			if a.gen ~= b.gen then return a.gen > b.gen end
			return a.uid < b.uid
		end)
		return results
	end

	local function findRowFrameByUID(uid)
		for _, c in ipairs(scroll:GetChildren()) do
			if c:IsA("Frame") and c:GetAttribute("_uid") == uid then
				return c
			end
		end
		return nil
	end

	local _lastRenderedFingerprint = ""
	local function updateGUI(results)
		local prevTargetUID = _target and _target.uid or nil
		local c = math.min(#results, 25)

		if c == 0 then
			if _lastRenderedFingerprint ~= "EMPTY" then
				_lastRenderedFingerprint = "EMPTY"
				for _, ch in ipairs(scroll:GetChildren()) do if ch:IsA("Frame") then ch:Destroy() end end
				scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
			end
			return
		end

		local fpParts = {}
		for i = 1, c do
			local d = results[i]
			fpParts[i] = tostring(d.uid) .. ":" .. tostring(d.gen)
		end
		fpParts[#fpParts + 1] = tostring(prevTargetUID)
		local currentFp = table.concat(fpParts, "|")

		if currentFp == _lastRenderedFingerprint and #scroll:GetChildren() > 1 then
			return
		end
		_lastRenderedFingerprint = currentFp

		for _, ch in ipairs(scroll:GetChildren()) do if ch:IsA("Frame") then ch:Destroy() end end
		selectedRowFrame = nil

		for i = 1, c do
			local data = results[i]
			local isSelected = (prevTargetUID and data.uid == prevTargetUID)

			local row = Instance.new("Frame")
			row.Size = UDim2.new(1, -4, 0, 44)
			row.BackgroundColor3 = THEME_PANEL
			row.BorderSizePixel = 0
			row.Parent = scroll
			row:SetAttribute("_uid", data.uid)
			Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)

			local rowStroke = Instance.new("UIStroke", row)
			rowStroke.Name = "_BaseStroke"
			rowStroke.Thickness = 1
			rowStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
			if data.source == "sync" then
				rowStroke.Color = THEME_BORDER
				rowStroke.Transparency = 0.2
			else
				rowStroke.Color = THEME_BORDER
				rowStroke.Transparency = 0.1
			end

			if isSelected then
				local selHL = Instance.new("UIStroke", row)
				selHL.Name = "_SelectHL"
				selHL.Color = THEME_ACCENT
				selHL.Thickness = 1.5
				selHL.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
				selectedRowFrame = row
