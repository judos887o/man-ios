    local function ownerIsMe(owner)
        local LP = Players.LocalPlayer
        if owner == nil or not LP then return false end
        if typeof(owner) == "Instance" then
            if owner == LP then return true end
            local ok, r = pcall(function()
                return owner:IsA("Player") and owner.UserId == LP.UserId
            end)
            return ok and r == true
        end
        if type(owner) == "number" then return owner == LP.UserId end
        if type(owner) == "string" then
            local o = string.lower(owner)
            return o == string.lower(LP.Name) or o == tostring(LP.UserId)
        end
        if type(owner) == "table" then
            local uid = tget(owner, "UserId") or tget(owner, "userId") or tget(owner, "Id")
            if uid ~= nil and tostring(uid) == tostring(LP.UserId) then return true end
            local nm = tget(owner, "Name") or tget(owner, "Username")
            if nm ~= nil and string.lower(tostring(nm)) == string.lower(LP.Name) then return true end
        end
        return false
    end
