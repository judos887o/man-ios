	local function _listComplete()
		if _scanPend ~= 0 or not AnimalsData then return false end
		local chans = _scanChans
		if type(chans) ~= "table" then return false end
		local kids = (_G.SXE_AllPlotKids and _G.SXE_AllPlotKids()) or {}
		if #kids == 0 then return false end
		for _, pl in ipairs(kids) do
