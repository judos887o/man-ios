		local RED = Color3.fromRGB(255, 45, 45)
		local DEFAULT_RANGE = 40
		local tracked = {}
		local folder
		local logged = false
		local function getFolder()
			if folder and folder.Parent then return folder end
			local parentGui = CoreGui
			if not pcall(function() return CoreGui:FindFirstChild("SMKT_TurretESP") end) then parentGui = (gethui and gethui()) or CoreGui end
			local old = parentGui:FindFirstChild("SMKT_TurretESP")
