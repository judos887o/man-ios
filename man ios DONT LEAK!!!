	local function _getCurrentPlot()
		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then return nil end
		local pf = Workspace:FindFirstChild("Plots")
		if not pf then return nil end

		local pPos = hrp.Position
		local closestPlot = nil
		local closestDist = math.huge

		for _, plot in ipairs(pf:GetChildren()) do
			local ok, cf, size = pcall(function() return plot:GetBoundingBox() end)
			if ok and cf and size then
				local rel = cf:PointToObjectSpace(pPos)
				if math.abs(rel.X) <= (size.X / 2) + 4 and math.abs(rel.Z) <= (size.Z / 2) + 4 and math.abs(rel.Y) <= (size.Y / 2) + 20 then
					return plot
				end
			end
			local okP, pCf = pcall(function() return plot:GetPivot() end)
			if okP and pCf then
				local d = (Vector3.new(pPos.X, 0, pPos.Z) - Vector3.new(pCf.Position.X, 0, pCf.Position.Z)).Magnitude
				if d < closestDist then
					closestDist = d
					closestPlot = plot
				end
			end
		end

		if closestDist <= 75 then
			return closestPlot
		end
		return nil
	end

