		local function isMine(m)
			local id = LP.UserId
			if string.find(m.Name, tostring(id), 1, true) then return true end
			for _, k in ipairs({ "Owner", "OwnerId", "OwnerUserId", "UserId", "Placer", "PlacedBy" }) do
				local v = m:GetAttribute(k)
				if v == id or v == tostring(id) or v == LP.Name then return true end
			end
			return false
		end
		local function isTurret(m)
			if not m:IsA("Model") then return false end
			local n = string.lower(m.Name)
			if not (string.find(n, "sentry", 1, true) or string.find(n, "turret", 1, true)) then return false end
			local a = m.Parent
			while a and a ~= workspace and a ~= game do
				if a:IsA("Backpack") or a:IsA("Tool") then return false end
				if a:IsA("Model") and a:FindFirstChildOfClass("Humanoid") then return false end
				a = a.Parent
			end
			if a ~= workspace then return false end
			if m:FindFirstChildOfClass("Humanoid") then return false end
			return true
		end
		local function rangeOf(m)
			local best = nil
			local function look(inst)
				local ok, at = pcall(function() return inst:GetAttributes() end)
				if ok and type(at) == "table" then
					for k, v in pairs(at) do
						local lk = string.lower(k)
						if type(v) == "number" and v >= 5 and v <= 400 and (string.find(lk, "range", 1, true) or string.find(lk, "radius", 1, true) or string.find(lk, "distance", 1, true)) then
							if not best or v > best then best = v end
						end
					end
				end
				if inst:IsA("NumberValue") or inst:IsA("IntValue") then
					local lk = string.lower(inst.Name)
					local v = inst.Value
					if v >= 5 and v <= 400 and (string.find(lk, "range", 1, true) or string.find(lk, "radius", 1, true)) then
						if not best or v > best then best = v end
					end
