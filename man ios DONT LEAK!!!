            facingDir = frontFace
            _frontApproach = true
        end

        local entryX = (destPos.X < COLUMN_SPLIT_X) and -450 or -370
        local entryY = hrp.Position.Y + ((_G.SMKTRealFlight == true) and ((adjY > 23.15) and 11 or 8) or 0)
        local zOffset = (destPos.Z > hrp.Position.Z) and -40 or 40
        if math.abs(hrp.Position.Z - destPos.Z) <= 35 then
            zOffset = (hrp.Position.Z > 60) and -20 or 20
        end
        _directionEntry = Vector3.new(entryX, entryY, destPos.Z + zOffset)
        if type(_G.TT3SafePoint) == "function" then
            local okS, sp = pcall(_G.TT3SafePoint, _directionEntry)
            if okS and typeof(sp) == "Vector3" then _directionEntry = sp end
        end
        do
            local cw = _G.TT3ClearWide
            if type(cw) == "function" then
                local okA, clearA = pcall(cw, hrp.Position, _directionEntry)
                if okA and not clearA then
                    local up = _directionEntry + Vector3.new(0, (adjY > 23.15) and 11 or 8, 0)
                    local okB, clearB = pcall(cw, hrp.Position, up)
                    if okB and clearB then _directionEntry = up end
                end
            end
        end

        if _G.TT3TPDebug then
        end
    end

    if facingDir and facingDir.Magnitude > 0.1 then
        local axis = facingDir.Unit
        local toPlayer = hrp.Position - destPos
        local sign = (axis:Dot(toPlayer) >= 0) and 1 or -1
        destPos = destPos + axis * sign * (tonumber(_G.TT3CloneBackoff) or 0.5)
    end

    do
        local _holdReleaseStuds = tonumber(_G.StealHoldReleaseStuds) or 16
        task.spawn(function()
            while _G.TT3StealHold do
                local _wh = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                if _wh and _wh.Parent and (_wh.Position - destPos).Magnitude <= _holdReleaseStuds then
                    _G.TT3StealHold = false
                    break
                end
                RunService.Heartbeat:Wait()
            end
        end)
    end

    local _route = {}
    local function _appendRoute(fromPos, toPos)
        local segment = computeRoute(fromPos, toPos, facingDir, nil, true)

        if not segment or #segment == 0 then
            segment = computeRoute(fromPos, toPos, nil, nil, true)
        end
        if not segment or #segment == 0 then segment = { toPos } end
        for _, point in ipairs(segment) do
            if #_route == 0 or (_route[#_route] - point).Magnitude > 0.5 then
                _route[#_route + 1] = point
            end
        end
    end
    _FLY.streamAhead(hrp.Position, destPos)
    _appendRoute(hrp.Position, _directionEntry)
    _appendRoute(_directionEntry, destPos)

    local ASCEND_STEP = 10
    local _stepped = {}
    do
        local prev = hrp.Position
        for _, wp in ipairs(_route) do
            local dy = wp.Y - prev.Y
            if dy > ASCEND_STEP * 1.5 then
                local n = math.ceil(dy / ASCEND_STEP)
                for s = 1, n - 1 do
                    local t = s / n
                    _stepped[#_stepped + 1] = Vector3.new(
                        prev.X + (wp.X - prev.X) * t,
                        prev.Y + dy * t,
                        prev.Z + (wp.Z - prev.Z) * t
                    )
                end
            end
            _stepped[#_stepped + 1] = wp
            prev = wp
        end
    end
    local _mainSpeed = math.clamp(tonumber(_G.TPVelocity) or 400, 20, 750)
    do
        local _len, _prev = 0, hrp.Position
        for _, wp in ipairs(_route) do _len = _len + (wp - _prev).Magnitude; _prev = wp end

        if _len < 100 then
            _mainSpeed = math.min(math.clamp(tonumber(_G.TT3CloseSpeed) or 80, 20, 750), math.clamp(tonumber(_G.TPVelocity) or 400, 20, 750))
        end
    end
    _mainSpeed = _pingAdjustSpeed(_mainSpeed)
    _CF.aim = _directionEntry or destPos
    _CF.engage(forceGrapple)
    _CF.preHold()
    if _G.TT3TPStop or _tpRun ~= _myRun then
        _G.TT3StealHold = false
        if _tpRun == _myRun then isTeleporting = false end
        return
    end
    vZero(hrp)
    _FLY.fly(hrp, _stepped, _mainSpeed, _frontApproach and "front" or "side",
        { _directionEntry, destPos }, facingDir, true)
    if (_G.TT3TPStop or _tpRun ~= _myRun) then
        if hrp and hrp.Parent then vZero(hrp) end
        _G.TT3StealHold = false
        if _tpRun == _myRun then isTeleporting = false end
        return
    end
    if _CF.active then pcall(_CF.stop) end

    do
        local above = destPos + Vector3.new(0, 16, 0)
        local _t0 = os.clock()
        while os.clock() - _t0 < 1.5 do
            if not hrp or not hrp.Parent then break end
            if LP:GetAttribute("Stealing") or (_G.TT3TPStop or _tpRun ~= _myRun) then break end
            equipCarpet()
            local d = above - hrp.Position
            local flat = Vector3.new(d.X, 0, d.Z).Magnitude
            if flat <= 3 and hrp.Position.Y >= destPos.Y then break end
            if d.Y > 3 then
                local _hum = hrp.Parent and hrp.Parent:FindFirstChildOfClass("Humanoid")
                if _hum then
                    local st = _hum:GetState()
                    if st ~= Enum.HumanoidStateType.Jumping and st ~= Enum.HumanoidStateType.Freefall then
                        pcall(function() _hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
                        pcall(function() _hum.Jump = true end)
                    end
                end
            end
            hrp.Velocity = d.Unit * math.min(math.max(d.Magnitude * 8, 55), 320, math.clamp(tonumber(_G.TPVelocity) or 400, 20, 750)) * ((_lbRun == _myRun) and _lbFactor or 1)
            hrp.AssemblyAngularVelocity = Vector3.zero
            RunService.Heartbeat:Wait()
        end
    end

    do
        local _runCap = _frontApproach and (tonumber(_G.TT3FrontRunIn) or 130) or 400
        local _t0 = os.clock()
        local _bestMag, _bestT = math.huge, os.clock()
        while os.clock() - _t0 < 4 do
            if not hrp or not hrp.Parent then break end
            if LP:GetAttribute("Stealing") or (_G.TT3TPStop or _tpRun ~= _myRun) then break end
            equipCarpet()
            local diff = destPos - hrp.Position
            local mag = diff.Magnitude
            if mag <= 3 then break end

            if mag < _bestMag - 0.5 then _bestMag = mag; _bestT = os.clock()
            elseif os.clock() - _bestT > 0.6 then break end
            if diff.Y > 3 then
                local _hum = hrp.Parent and hrp.Parent:FindFirstChildOfClass("Humanoid")
                if _hum then
                    local st = _hum:GetState()
                    if st ~= Enum.HumanoidStateType.Jumping and st ~= Enum.HumanoidStateType.Freefall then
                        pcall(function() _hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
                        pcall(function() _hum.Jump = true end)
                    end
                end
            end

            hrp.Velocity = diff.Unit * math.min(math.max(mag * 8, 55), _runCap, math.clamp(tonumber(_G.TPVelocity) or 400, 20, 750)) * ((_lbRun == _myRun) and _lbFactor or 1)
            hrp.AssemblyAngularVelocity = Vector3.zero
            RunService.Heartbeat:Wait()
        end
    end

    if hrp and hrp.Parent and not (_G.TT3TPStop or _tpRun ~= _myRun) then
        local _flatOff = Vector3.new(destPos.X - hrp.Position.X, 0, destPos.Z - hrp.Position.Z).Magnitude
        if _flatOff > 10 then
            if _G.TT3TPDebug then
            end

            local CRUISE_Y = math.max(destPos.Y, hrp.Position.Y) + 40
            local function _airborne()
                local _hum = hrp.Parent and hrp.Parent:FindFirstChildOfClass("Humanoid")
                if _hum then
                    local st = _hum:GetState()
                    if st ~= Enum.HumanoidStateType.Jumping and st ~= Enum.HumanoidStateType.Freefall then
                        pcall(function() _hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
                        pcall(function() _hum.Jump = true end)
                    end
                end
            end
            local _t0 = os.clock()
            while os.clock() - _t0 < 2 do
                if not hrp or not hrp.Parent or (_G.TT3TPStop or _tpRun ~= _myRun) or LP:GetAttribute("Stealing") then break end
                equipCarpet()
                local dy = CRUISE_Y - hrp.Position.Y
                if dy <= 2 then break end
                _airborne()
                hrp.Velocity = Vector3.new(0, math.min(240, dy * 8, math.clamp(tonumber(_G.TPVelocity) or 400, 20, 750)), 0)
                hrp.AssemblyAngularVelocity = Vector3.zero
                RunService.Heartbeat:Wait()
            end
            _t0 = os.clock()
            while os.clock() - _t0 < 3 do
                if not hrp or not hrp.Parent or (_G.TT3TPStop or _tpRun ~= _myRun) or LP:GetAttribute("Stealing") then break end
                equipCarpet()
                local d = Vector3.new(destPos.X - hrp.Position.X, 0, destPos.Z - hrp.Position.Z)
                if d.Magnitude <= 2.5 then break end
                _airborne()
                local lift = math.max(0, CRUISE_Y - hrp.Position.Y) * 4
                hrp.Velocity = d.Unit * (math.min(400, d.Magnitude * 8, math.clamp(tonumber(_G.TPVelocity) or 400, 20, 750)) * ((_lbRun == _myRun) and _lbFactor or 1)) + Vector3.new(0, lift, 0)
                hrp.AssemblyAngularVelocity = Vector3.zero
                RunService.Heartbeat:Wait()
            end
            _t0 = os.clock()
            while os.clock() - _t0 < 2.5 do
                if not hrp or not hrp.Parent or (_G.TT3TPStop or _tpRun ~= _myRun) or LP:GetAttribute("Stealing") then break end
                equipCarpet()
                local d = destPos - hrp.Position
                if d.Magnitude <= 3 then break end
                hrp.Velocity = d.Unit * math.min(200, d.Magnitude * 6, math.clamp(tonumber(_G.TPVelocity) or 400, 20, 750))
                hrp.AssemblyAngularVelocity = Vector3.zero
                RunService.Heartbeat:Wait()
            end
            if hrp and hrp.Parent then
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end
        end
    end

    local _hoverOn = _G.SMKTCloneHover ~= false
    local _hoverConn, _hoverHums = nil, {}
    local _hoverY = nil
    local function _hoverStop()
        if _hoverConn then pcall(function() _hoverConn:Disconnect() end); _hoverConn = nil end
        for h in pairs(_hoverHums) do
            pcall(function() h:SetStateEnabled(Enum.HumanoidStateType.Jumping, true) end)
        end
        table.clear(_hoverHums)
    end
    if _hoverOn and hrp and hrp.Parent then
        _hoverY = hrp.Position.Y
        local _hoverT0 = os.clock()
        _hoverConn = RunService.Heartbeat:Connect(function()
            if os.clock() - _hoverT0 > (tonumber(_G.SMKTCloneHoverMax) or 6) or _G.TT3TPStop then _hoverStop() return end
            local c = LP.Character
            local h = c and c:FindFirstChild("HumanoidRootPart")
            local hm = c and c:FindFirstChildOfClass("Humanoid")
            if hm then
                if not _hoverHums[hm] then
                    _hoverHums[hm] = true
                    pcall(function() hm:SetStateEnabled(Enum.HumanoidStateType.Jumping, false) end)
                end
                hm.Jump = false
            end
            if not h or not h.Parent then return end
            local vy = math.clamp((_hoverY - h.Position.Y) * 12, -40, 40)
            h.AssemblyLinearVelocity = Vector3.new(0, vy, 0)
            h.AssemblyAngularVelocity = Vector3.zero
        end)
    end

    local _realClone = _G.SMKTCloneSnap ~= true
    if _realClone then
        vZero(hrp)
        _faceSmooth(hrp, facingDir, 0.15, 30)
    else
        if hrp and hrp.Parent then
            hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + facingDir)
        end
        vZero(hrp)
        local syncFrames = 5
        local syncConn
        syncConn = RunService.Heartbeat:Connect(LPH_NO_VIRTUALIZE(function()
            if not hrp or not hrp.Parent then syncConn:Disconnect(); return end
            syncFrames = syncFrames - 1
            hrp.CFrame = CFrame.new(destPos, destPos + facingDir)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            if syncFrames <= 0 then syncConn:Disconnect() end
        end))
    end

    for _ = 1, 3 do
        if _hoverConn then break end
        if (_G.TT3TPStop or _tpRun ~= _myRun) then break end
        if hum.FloorMaterial ~= Enum.Material.Air then break end
        task.wait(0.05)
    end

    do

        local stable = 0
        for _ = 1, (_hoverConn and 0 or 50) do
            if (_G.TT3TPStop or _tpRun ~= _myRun) then break end
            local _hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not _hrp or not _hrp.Parent then break end
            local flat = (Vector3.new(_hrp.Position.X, 0, _hrp.Position.Z) - Vector3.new(destPos.X, 0, destPos.Z)).Magnitude
            if flat <= 3.5 and math.abs(_hrp.Position.Y - (_hoverY or destPos.Y)) <= 4 then
                stable = stable + 1
                if stable >= 2 then break end
            elseif _realClone then
                stable = 0
                local dv = destPos - _hrp.Position
                if _hoverConn then dv = Vector3.new(dv.X, 0, dv.Z) end
                if dv.Magnitude > 0.05 then
                    local hv = dv.Unit * math.min(120, dv.Magnitude * 15)
                    _hrp.AssemblyLinearVelocity = _hoverConn and Vector3.new(hv.X, _hrp.AssemblyLinearVelocity.Y, hv.Z) or hv
                end
                _hrp.AssemblyAngularVelocity = Vector3.zero
            else
                stable = 0
                pcall(function() _hrp.CFrame = CFrame.new(destPos, destPos + facingDir) end)
                _hrp.AssemblyLinearVelocity = Vector3.zero
                _hrp.AssemblyAngularVelocity = Vector3.zero
            end
            RunService.Heartbeat:Wait()
        end
    end
    local _ahrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local _clonePos = (_ahrp and _ahrp.Parent and _ahrp.Position) or destPos

    local _clonePlat = nil
    if not _hoverConn then
        _clonePlat = Instance.new("Part")
        _clonePlat.Name = "TT3HubClonePlatform"
        _clonePlat.Size = Vector3.new(12, 1, 12)
        _clonePlat.Position = Vector3.new(_clonePos.X, _clonePos.Y - 3, _clonePos.Z)
        _clonePlat.Anchored = true
        _clonePlat.CanCollide = true
        _clonePlat.Transparency = 1
        _clonePlat.Material = Enum.Material.SmoothPlastic
        _clonePlat.Parent = workspace
    end

    if _ahrp and _ahrp.Parent then
        _ahrp.AssemblyLinearVelocity = Vector3.zero
        _ahrp.AssemblyAngularVelocity = Vector3.zero
    end

    local _preClonePos, _preCloneChar
    do
        _preCloneChar = LP.Character
        local _h = _preCloneChar and _preCloneChar:FindFirstChild("HumanoidRootPart")
        _preClonePos = _h and _h.Position or destPos
    end
    local _charAdded = false
    local _caConn = LP.CharacterAdded:Connect(function() _charAdded = true end)

    _G.TT3StealHold = false

    task.wait(tonumber(_G.TPCloneDelay) or tonumber(_G.LandingDelay) or 0.1)

    if facingDir and facingDir.Magnitude > 0.1 then
        local _pinHum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if _pinHum then pcall(function() _pinHum.AutoRotate = false end) end
        for _ = 1, 4 do
            local _h = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if not _h or not _h.Parent then break end
            pcall(function()
                if not _realClone then _h.CFrame = CFrame.new(_h.Position, _h.Position + facingDir) end
                _h.AssemblyLinearVelocity = Vector3.zero
                _h.AssemblyAngularVelocity = Vector3.zero
            end)
            RunService.Heartbeat:Wait()
        end
    end

    local _cloneT0 = os.clock()
    local _clLog = {}
    do
        local h0 = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if h0 then
            local lv = h0.CFrame.LookVector
            _clLog.pos = h0.Position
            _clLog.txt = string.format("%s approach=%s plot=%s dest=%.1f,%.1f,%.1f at=%.1f,%.1f,%.1f off=%.1f dy=%.1f look=%.2f,%.2f face=%.0f,%.0f hover=%s",
                os.date("%H:%M:%S"), _frontApproach and "FRONT(laser)" or "side", tostring(pet.plot),
                destPos.X, destPos.Y, destPos.Z, h0.Position.X, h0.Position.Y, h0.Position.Z,
                Vector3.new(h0.Position.X - destPos.X, 0, h0.Position.Z - destPos.Z).Magnitude, h0.Position.Y - destPos.Y,
                lv.X, lv.Z, facingDir.X, facingDir.Z, tostring(_hoverConn ~= nil))
        end
    end
    local _cloneOk = doClone()
    if _clonePlat then pcall(function() _clonePlat:Destroy() end); _clonePlat = nil end
    local _swapped = false
    do
        local _t0 = os.clock()
        local _lastP, _baseP = nil, nil
        repeat
            if _charAdded or LP.Character ~= _preCloneChar then _swapped = true; break end
            local _h = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if _h then
                local p = _h.Position
                _baseP = _baseP or p
                if _lastP then
                    local jx, jz = p.X - _lastP.X, p.Z - _lastP.Z
                    if (jx * jx + jz * jz) >= 2.25 then _swapped = true; break end
                end
                local _dx, _dz = p.X - _baseP.X, p.Z - _baseP.Z
                if (_dx * _dx + _dz * _dz) >= 2.25 then _swapped = true; break end
                _lastP = p
                local v = _h.AssemblyLinearVelocity
                _h.AssemblyLinearVelocity = Vector3.new(0, _hoverConn and v.Y or math.min(v.Y, 0), 0)
                _h.AssemblyAngularVelocity = Vector3.zero
            end
            RunService.Heartbeat:Wait()
        until os.clock() - _t0 > 2.5 or (_G.TT3TPStop or _tpRun ~= _myRun)
        if _swapped then
            _G.SMKTSwapAt = os.clock()
        end
        _hoverStop()
        _CF.log(string.format("clone swap: %s after %.2fs", _swapped and "detected" or "NOT detected", os.clock() - _t0))
    end
    if _caConn then _caConn:Disconnect() end
    do
        local _h = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        local cl = workspace:FindFirstChild(tostring(LP.UserId) .. "_Clone")
        local clp
        pcall(function() clp = cl and cl:GetPivot().Position end)
        local line = tostring(_clLog.txt or os.date("%H:%M:%S")) .. string.format(" | swap=%s moved=%.1f clone=%s",
            tostring(_swapped), (_h and _clLog.pos) and (_h.Position - _clLog.pos).Magnitude or -1,
            clp and string.format("%.1f,%.1f,%.1f (%.1f studs from start)", clp.X, clp.Y, clp.Z, _clLog.pos and (clp - _clLog.pos).Magnitude or -1) or "none")
        if type(writefile) == "function" then
            pcall(function()
                local old = (isfile and isfile("smkt_clone_place.txt")) and readfile("smkt_clone_place.txt") or ""
                if #old > 12000 then old = string.sub(old, -8000) end
                writefile("smkt_clone_place.txt", old .. line .. "\n")
            end)
        end
    end
    if not _swapped and not (_G.TT3TPStop or _tpRun ~= _myRun) then
        local _h = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        local okIn, inside = pcall(_insidePlot, pet.plot, _h and _h.Position or _preClonePos)
        if not (okIn and inside) then
            _G.TPStatus = "clone: no swap"
            if _frontApproach and os.clock() - (tonumber(_G.SMKTFrontRetryAt) or -math.huge) > 8 then
                _G.SMKTFrontFailPlot = tostring(pet.plot)
                _G.SMKTFrontFailAt = os.clock()
                _G.SMKTFrontRetryAt = os.clock()
                _CF.log("clone at laser front failed -> retrying from the side")
                task.delay(0.15, function()
                    if type(_G.SXE_SMKTDoTP) == "function" and LP:GetAttribute("Stealing") ~= true then pcall(_G.SXE_SMKTDoTP) end
                end)
            end
            pcall(function()
                local _rh = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
                if _rh then _rh.AutoRotate = true end
            end)
            _G.TT3StealHold = false
            if _tpRun == _myRun then isTeleporting = false end
            return
        end
    end

    if _G.SMKTGrappleAfterSwap ~= false and not (_G.TT3TPStop or _tpRun ~= _myRun) then
        _G.SMKTSwapAt = _G.SMKTSwapAt and math.max(_G.SMKTSwapAt, _cloneT0) or _cloneT0
        local okG, firedG, whyG = pcall(_swapGrappleFast, petPos)
        _CF.log("swap-grapple: fired=" .. tostring(okG and firedG) .. " " .. tostring(whyG))
    end

    pcall(function()
        local _rh = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if _rh then _rh.AutoRotate = true end
    end)

    do
        local okR, np = pcall(_tpRecheck, pet)
        if okR and type(np) == "table" and np ~= pet and typeof(np.position) == "Vector3" then
            pet = np
            petPos = np.position
        end
    end
    goToBrainrot(petPos, pet and pet.slot, nil, _G.SMKTCloneWalk ~= false)
    do
        local _ta = tonumber(_G.SMKTArrivedAt)
        if _ta and _ta > _cloneT0 and _ta - _cloneT0 < 3 then
            _G.SMKTCloneLead = (tonumber(_G.SMKTCloneLead) or 0.5) * 0.6 + (_ta - _cloneT0) * 0.4
        end
    end
    if not (_G.TT3TPStop or _tpRun ~= _myRun) then _G.TPStatus = "done" end

    if _tpRun == _myRun then isTeleporting = false end
    if (_G.TT3TPStop or _tpRun ~= _myRun) then return end
    _rememberLastBrainrot(pet, LP.Character and LP.Character:FindFirstChild("HumanoidRootPart"))
    if _G.TT3ArmSteal then pcall(_G.TT3ArmSteal, pet) end
end

local function doVelocityTP(forceGrapple)
    if isTeleporting then return end
    _tpRun += 1
    local _wRun = _tpRun
    _G.SMKTIsTeleporting = true
    _G.TPStatus = "running"
    if _G.__SXE_LoadedAt then
    end
    _G.TT3TPJumpBlocked = true
    _CF.log("tp start")
    local ok, err = pcall(_doVelocityTPCore, forceGrapple)
    _CF.log("tp end status=" .. tostring(_G.TPStatus) .. (ok and "" or (" error=" .. tostring(err))))
    task.spawn(_CF.stop)
    pcall(_tpEndObstaclePassage)
    if _tpRun ~= _wRun then return end
    _G.TT3TPJumpBlocked = false
    _G.SMKTIsTeleporting = false
    if _G.TPStatus == "running" then _G.TPStatus = "aborted" end
    if not ok then
        _G.TT3StealHold = false
        isTeleporting = false
        _G.TPStatus = "error"
    end
end

do
    local returnBusy, lastReturnAt = false, 0
    local RAGDOLL_RETURN_STATES = {
        [Enum.HumanoidStateType.Ragdoll] = true,
        [Enum.HumanoidStateType.FallingDown] = true,
    }
    local function _isInsideBrainrotBase(record)
        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local plots = workspace:FindFirstChild("Plots")
        local targetName = record and record.plot
        if not root or not plots or type(targetName) ~= "string" then return false end
        local plot = plots:FindFirstChild(targetName)
        if not plot then return false end
        local ok, cf, size = pcall(function() return plot:GetBoundingBox() end)
        if not ok or not cf or not size then return false end
        local pos = cf:PointToObjectSpace(root.Position)
        return math.abs(pos.X) <= size.X * 0.5 + 2
            and math.abs(pos.Z) <= size.Z * 0.5 + 2
    end
    local function _isFarFromLastTarget(record, root)
        if not record or not root then return false end
        local ref = record.anchor or record.position
        if typeof(ref) ~= "Vector3" then return false end
        return (root.Position - ref).Magnitude >= (tonumber(_G.TT3GoToBrainrotHitDistance) or 12)
