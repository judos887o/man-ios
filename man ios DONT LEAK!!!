    if c and now - c.at < 3 then return c.parts end
    local parts = {}
    pcall(function()
        local beamPart = {}
        local laser = plot:FindFirstChild("Laser")
        if laser then
            for _, d in ipairs(laser:GetDescendants()) do
                if d:IsA("Beam") then
                    local a0, a1 = d.Attachment0, d.Attachment1
                    if a0 and a0.Parent and a0.Parent:IsA("BasePart") then beamPart[a0.Parent] = true end
                    if a1 and a1.Parent and a1.Parent:IsA("BasePart") then beamPart[a1.Parent] = true end
                end
            end
        end
        for _, d in ipairs(plot:GetDescendants()) do
            if d:IsA("BasePart") then
                if d.Name == "LaserHitbox" or d.Name == "Laser" then
                    parts[#parts + 1] = d
                else
                    local x = d.Parent
                    while x and x ~= plot do
                        if x.Name == "LaserHitbox" then
                            parts[#parts + 1] = d
                            break
                        elseif x.Name == "Laser" then
                            if beamPart[d] or _laserLike(d) then parts[#parts + 1] = d end
                            break
