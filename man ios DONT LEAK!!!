	local function glassify(root)
		local function isTop(o)
			return o.Parent and (o.Parent:IsA("ScreenGui") or o.Parent:IsA("LayerCollector"))
		end
		local function style(o)
			if o:IsA("UIStroke") then
				if o.Name == "_SelectHL" then o.Color = GLASS.on; o.Transparency = 0; o.Thickness = 1.5; return end
				local p = o.Parent
				if p and (p.Name == "Fill" or p.Name == "StealBarBg") then return end
				o.Color = GLASS.border
				o.Transparency = 0
				o.Thickness = 1
				return
			end
			if not o:IsA("GuiObject") then return end
			if string.sub(o.Name, 1, 1) == "_" and o.Name ~= "_SelectHL" then return end
			if isTop(o) then
				if (tonumber(o.BackgroundTransparency) or 0) >= 1 then return end
				o.BackgroundTransparency = GLASS.bgT
				corner(o, 8)
				stroke(o)
				sky(o)
				return
			end
			if o:IsA("ScrollingFrame") then o.ScrollBarImageColor3 = GLASS.onLight; return end
			if o.Name == "Fill" or o.Name == "StealBarBg" then return end
			if (tonumber(o.BackgroundTransparency) or 0) < 1 then
				o.BackgroundColor3 = GLASS.item
				o.BackgroundTransparency = GLASS.itemT
			end
		end
		for _, o in ipairs(root:GetDescendants()) do pcall(style, o) end
		root.DescendantAdded:Connect(function(o) task.defer(function() pcall(style, o) end) end)
	end
