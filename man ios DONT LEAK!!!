local function flPickStands(plot, slots, hrp, maxN)
    local out = {}
    local list = _FLASH_STANDS[plot:GetAttribute("Order")]
    local mr = plot:FindFirstChild("MainRoot")
    if not list or not mr or not mr:IsA("BasePart") then return out end
    local cf = mr.CFrame
    local o = cf:PointToObjectSpace(hrp.Position)
    local q = {}
    for _, s in ipairs(slots) do
        for _, u in ipairs(list[s] or {}) do
            q[#q + 1] = { u, (u[1] - o.X) ^ 2 + (u[2] - o.Z) ^ 2 }
        end
    end
    table.sort(q, function(a, b) return a[2] < b[2] end)
    for _, it in ipairs(q) do
        local p, d = flStandWorld(cf, it[1])
        if p and flUsable(p) then
            local dup = false
            for _, e in ipairs(out) do
                if ((e[1] - p) * FL_FLAT).Magnitude < 4 then dup = true; break end
            end
            if not dup then
                out[#out + 1] = { p, d, ((p - hrp.Position) * FL_FLAT).Magnitude + (flThreat(p) and 250 or 0) }
                if #out >= maxN + 3 then break end
            end
        end
    end
    table.sort(out, function(a, b) return a[3] < b[3] end)
    while #out > maxN do table.remove(out) end
    return out
end
