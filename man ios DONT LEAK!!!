                for _, c in ipairs(packetConns) do pcall(function() c:Disconnect() end) end
                if SH.remoteOwner == ME then SH.remoteBusyUntil = 0 end
                break
            end
            if not REG_FULL then
                pcall(function()
                    if checkCheap() then return end
                    remoteStep(12)
                    if checkCheap() then return end
                    gcScan(false)
                end)
                if REG_FULL then
                    for _, c in ipairs(packetConns) do pcall(function() c:Disconnect() end) end
                    for _, c in ipairs(listenConns) do pcall(function() c:Disconnect() end) end
                    table.clear(packetConns)
                    table.clear(listenConns)
                end
            elseif os.clock() - lastWatch > 2 then
                lastWatch = os.clock()
                local bad = regCount(REG) == 0
                if not bad and os.clock() - REG_AT > 4 then
                    bad = not hasPlotChans(REG)
                end
                if bad then
                    local old = REG
                    REG_FULL, REG, CAND = false, nil, nil
                    gcTries = 0
                    collected, RPRIO, RREST, RST = false, { pos = 0 }, { pos = 0 }, {}
                    if old ~= nil then
                        if rawget(_G, "SabcomRegistry") == old then _G.SabcomRegistry = nil end
                        if rawget(_G, "SMKTRegistry") == old then _G.SMKTRegistry = nil end
                        if rawget(ENV, "SabcomRegistry") == old then ENV.SabcomRegistry = nil end
                        if rawget(ENV, "SMKTRegistry") == old then ENV.SMKTRegistry = nil end
                    end
                end
            end
            local el = os.clock() - T_START
            if REG_FULL then
                task.wait(0.5)
            elseif el < 20 then
                RunService.Heartbeat:Wait()
            elseif el < 120 then
                task.wait(0.25)
            else
                task.wait(2)
            end
        end
    end)

