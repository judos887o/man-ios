	local FOLDERS = { "Base", "PlotSign", "FriendPanel", "Cash", "Laser",
		"Decorations", "Skin", "Unlock", "Purchases" }
	local function curAlpha() return math.clamp(tonumber(_G.SMKTXrayAlpha) or 0.5, 0, 0.95) end
	local ALPHA = curAlpha()
	local orig = setmetatable({}, { __mode = "k" })
	local tracked = setmetatable({}, { __mode = "k" })
	local function paint(o)
		if not o:IsA("BasePart") then return end
		if orig[o] == nil then orig[o] = (o.Transparency == ALPHA) and 0 or o.Transparency end
		local base = orig[o]
		if base >= 1 then return end
		local want = base + (1 - base) * ALPHA
		if math.abs(o.Transparency - want) > 0.01 then o.Transparency = want end
	end
	_G.SMKTXrayRepaint = function()
		ALPHA = curAlpha()
		for o, base in pairs(orig) do
			if o.Parent and base < 1 then
				pcall(function() o.Transparency = base + (1 - base) * ALPHA end)
			end
		end
	end
	local function calm()
		while _G.SMKTStealHold or _G.MeerkoStealHold or _G.TT3StealHold do task.wait(0.15) end
	end
	local function track(root)
		if not root or tracked[root] then return end
		tracked[root] = true
		pcall(paint, root)
		local n = 0
		for _, d in ipairs(root:GetDescendants()) do
			pcall(paint, d)
			n += 1
			if n % 250 == 0 then task.wait() end
		end
		root.DescendantAdded:Connect(function(d) pcall(paint, d) end)
	end
	local function doPlot(plot)
		if not plot then return end
		for _, fname in ipairs(FOLDERS) do track(plot:FindFirstChild(fname)) end
		if not tracked[plot] then
			tracked[plot] = true
			plot.ChildAdded:Connect(function(c)
				for _, fname in ipairs(FOLDERS) do
					if c.Name == fname then track(c) break end
				end
			end)
		end
		local pods = plot:FindFirstChild("AnimalPodiums")
		if not pods then return end
		local function pod(pd)
			for _, c in ipairs(pd:GetChildren()) do
				if c.Name == "Claim" then track(c)
				elseif c.Name == "Base" then track(c:FindFirstChild("Decorations")) end
			end
		end
		for _, pd in ipairs(pods:GetChildren()) do pod(pd) end
		if not tracked[pods] then
			tracked[pods] = true
			pods.ChildAdded:Connect(function(pd) task.wait(0.1); pod(pd) end)
		end
	end
	if not game:IsLoaded() then game.Loaded:Wait() end
	task.wait(1)
	local plots = workspace:FindFirstChild("Plots") or workspace:WaitForChild("Plots", 60)
	if not plots then return end
	calm()
	for _, pl in ipairs(plots:GetChildren()) do
		pcall(doPlot, pl)
		task.wait()
		calm()
	end
	plots.ChildAdded:Connect(function(pl) task.wait(0.2); pcall(doPlot, pl) end)
end)

