local function _grAim(hrp, char, target)
    local par = RaycastParams.new()
    par.FilterType = Enum.RaycastFilterType.Exclude
    par.FilterDescendantsInstances = { char }
    local destino = typeof(target) == "Vector3" and target or (hrp.Position + hrp.CFrame.LookVector * 20)
    local dir = destino - hrp.Position
    dir = Vector3.new(dir.X, 0, dir.Z)
    if dir.Magnitude < 1 then
        local lv = hrp.CFrame.LookVector
        dir = Vector3.new(lv.X, 0, lv.Z)
    end
    if dir.Magnitude < 0.01 then dir = Vector3.new(0, 0, -1) end
    dir = dir.Unit
    local pos, alvo, best
    for _, d in ipairs({ 9, 10, 11, 12, 13, 14, 16, 18, 21, 24, 28, 32, 36, 40, 45 }) do
        local hit = workspace:Raycast(hrp.Position + dir * d + Vector3.new(0, 3, 0), Vector3.new(0, -60, 0), par)
        if hit then
            local m = (hit.Position - hrp.Position).Magnitude
            if m >= 10 and m <= 50 and (not best or m < best) then pos, alvo, best = hit.Position, hit.Instance, m end
        end
    end
    if not pos then
        for _, d in ipairs({ 11, 14, 18, 24, 32, 42, 48 }) do
            local hit = workspace:Raycast(hrp.Position, dir * d, par)
            if hit then
                local m = (hit.Position - hrp.Position).Magnitude
                if m >= 10 and m <= 50 and (not best or m < best) then pos, alvo, best = hit.Position, hit.Instance, m end
            end
        end
    end
    if not pos then pos = hrp.Position + dir * 20 - Vector3.new(0, 3, 0) end
    return pos, alvo
end
