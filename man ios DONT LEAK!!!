	local function _cycle()
		local beginEv, grabEv = _remBegin, _remGrab
		if not (beginEv and beginEv.Parent and grabEv and grabEv.Parent) then
			_idle(_remState == "connecting" and "connecting steal remotes" or "steal remotes not found")
			return false
		end
		local _, hrp, hum = _char()
		if not hrp or not hum or hum.Health <= 0 then
			_idle("no character")
			return false
		end
		if _carrying() then
			_chargeAt = nil
			_idle("carrying")
			return false
		end
		local now = os.clock()
		if now - _scanAt >= 0.1 then
			_scanAt = now
			pcall(_rescan)
		end
		_useHitbox = true
		local target, why = _pick(hrp)
		if not target then
			if now - _noTgtAt >= 0.5 then
				_noTgtAt = now
				local nb, nd, nAv = nil, math.huge, 0
				for _, c in ipairs(_cands) do
					local pp = _promptPos(c.prompt)
					if pp then
						local dd = (hrp.Position - pp).Magnitude
						if _available(c.prompt) then nAv += 1 end
						if dd < nd then nb, nd = c, dd end
					end
				end
				local noneLine = string.format("why=%s cands=%d avail=%d nearest=%s#%s d=%.1f av=%s r=%s sel=%s", tostring(why), #_cands, nAv, nb and tostring(nb.name) or "-", nb and tostring(nb.slot) or "-", nd, nb and tostring(_available(nb.prompt)) or "-", tostring(Hub.State.autoGrabRange), type(getgenv().SMKT_SelectedData) == "table" and (tostring(getgenv().SMKT_SelectedData.name) .. "#" .. tostring(getgenv().SMKT_SelectedData.slot)) or "-")
				if noneLine ~= _lastNone then
					_lastNone = noneLine
					_tr("none " .. noneLine)
				end
			end
			_chargeAt = nil
			local preP = nil
			local okP, pt = pcall(_preTarget)
			if okP and pt then
				local dP = (hrp.Position - pt.pos).Magnitude
				local radiusP = _agRadius()
				local tpP = _G.SMKTIsTeleporting == true or _G.TT3StealHold == true
				local gateP = tpP and math.max(radiusP, _armCap) or radiusP
				if dP <= gateP and not _flashBusy() then
					if not _carryE or now - _carryE > _holdWindow() - 0.4 then
						if type(_G.SMKTFireGrapple) == "function" then pcall(_G.SMKTFireGrapple, "prebegin", tostring(pt.plot) .. "#" .. tostring(pt.slot)) end
						local fired = _beginAllowed() and _netFire(beginEv, _rows("Begin"))
						if fired then
							_carryE = now
							_G.SMKTPreBeginAt = now
							_G.SMKTPreBeginNeed = _holdMin()
							_tr(string.format("PREBEGIN %s#%s d=%.1f cands=%d", tostring(pt.plot), tostring(pt.slot), dP, #_cands))
						else
							preP = math.clamp((now - (_carryE or now)) / _holdMin(), 0, 1)
						end
					end
					if _carryE then preP = math.clamp((now - _carryE) / _holdMin(), 0, 1) end
				end
			end
			if why ~= "target is being stolen, waiting" and (_G.SMKTIsTeleporting == true or _G.TT3StealHold == true) then
				_idle("TP running")
			else
				_idle(why)
			end
			if preP then
				AG_State.IsStealing = true
				AG_State.StealProgress = preP
				AG_State.Status = string.format("charging %d%% (prompt loading)", math.floor(preP * 100))
			end
			return false
		end
		local began, bd = _chargeAt, _chargeDist
		_chargeAt = nil
		local sent, used, okC, lastBegin = _fireSteal(target, beginEv, grabEv, began, bd)
		used = used or target

		if sent then
			if okC then
				AG_State.StealCount = (AG_State.StealCount or 0) + 1
				_uidFails[used.uid] = nil
			else
				_uidFails[used.uid] = (_uidFails[used.uid] or 0) + 1
				_failUntil[used.uid] = os.clock() + (used.isSel and 0.25 or 0.6)
				if type(_G.SMKT_LobbyResync) == "function" then pcall(_G.SMKT_LobbyResync, used.plotName, "grab fail") end
			end
			pcall(_logGrab, used, okC)
		else
			if used.why and used.why ~= "-" and not string.find(tostring(used.why), "never arrived", 1, true) then pcall(_logGrab, used, nil) end
		end
		return true
	end

