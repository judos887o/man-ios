    local stepped = _FLY.stepRoute(hrp.Position, route)
    local len, prev = 0, hrp.Position
    for _, wp in ipairs(route) do len += (wp - prev).Magnitude; prev = wp end
    local spd = math.clamp(tonumber(_G.TPVelocity) or 400, 20, 750)
    if len < 100 then spd = math.min(math.clamp(tonumber(_G.TT3CloseSpeed) or 80, 20, 750), math.clamp(tonumber(_G.TPVelocity) or 400, 20, 750)) end
