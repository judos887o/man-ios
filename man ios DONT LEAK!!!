				if minG > 0 and not pri and gen < minG then continue end
				if not st then
					st = { owner = owner, tries = 0, nextAt = 0 }
					state[p] = st
				end
				st.name = name
				if now >= st.nextAt then
					cands[#cands + 1] = { p = p, st = st, uid = uid, d = d, name = name, gen = gen, pri = pri or math.huge, owner = owner }
				end
			end
			if #cands == 0 then return end
			if #cands > 1 then table.sort(cands, sorter) end
			local okP, ping = pcall(LP.GetNetworkPing, LP)
			local gap = math.clamp((okP and tonumber(ping) or 0.1) * 2 + 0.15, 0.3, 1)
			for i = 1, math.min(#cands, 3) do
				local c = cands[i]
				local st = c.st
				st.tries += 1
				st.nextAt = now + ((st.tries >= 8) and 0.8 or gap)
				fire(c, st)
			end
		end
