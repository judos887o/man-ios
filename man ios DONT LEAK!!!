AG_State.Approach = function(pp)
	local Pl = game:GetService("Players")
	local LPx = Pl.LocalPlayer
	local HB = game:GetService("RunService").Heartbeat
	local c = LPx.Character
	local hrp = c and c:FindFirstChild("HumanoidRootPart")
	local hum = c and c:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or not pp then return "nochar" end
	local ex = {}
	for _, p in ipairs(Pl:GetPlayers()) do if p.Character then ex[#ex + 1] = p.Character end end
	local par = RaycastParams.new()
	par.FilterType = Enum.RaycastFilterType.Exclude
	par.FilterDescendantsInstances = ex
	par.RespectCanCollide = true
	local function clear(a, b)
		local hit = workspace:Raycast(a, b - a, par)
		return (not hit) or (hit.Position - b).Magnitude <= 6
	end
	local goal = Vector3.new(pp.X, pp.Y + 2.5, pp.Z)
	local wps
	local how = "direct"
	if math.abs(goal.Y - hrp.Position.Y) <= 6 and clear(hrp.Position, Vector3.new(goal.X, hrp.Position.Y, goal.Z)) then
		wps = { goal }
	else
		how = "path"
		local ok = pcall(function()
			local path = game:GetService("PathfindingService"):CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true, WaypointSpacing = 5 })
			path:ComputeAsync(hrp.Position, pp)
			if path.Status == Enum.PathStatus.Success then
				wps = {}
				for _, w in ipairs(path:GetWaypoints()) do wps[#wps + 1] = w.Position + Vector3.new(0, 2.5, 0) end
			end
		end)
		if not ok or not wps or #wps == 0 then return "no path" end
	end
	local cfA = rawget(_G, "SMKT_CF")
	local flew = false
	if cfA and _G.SMKTApproachFlight == true then
		local okS, got = pcall(cfA.start)
		flew = okS and got == true
	end
	if not flew and type(_G.SMKTEquipCarpet) == "function" then
		local e0 = os.clock()
		repeat
			local okE, cn = pcall(_G.SMKTEquipCarpet)
			if okE and cn and c:FindFirstChild(cn) then break end
			HB:Wait()
		until os.clock() - e0 > 0.6
	end
	local spd = math.min(tonumber(_G.SMKTApproachSpeed) or 90, tonumber(_G.SMKTGoSpeed) or 250, math.clamp(tonumber(_G.TPVelocity) or 250, 20, 750))
	local t0 = os.clock()
	local i = 1
	while i <= #wps and os.clock() - t0 < 8 do
		if LPx:GetAttribute("Stealing") or _G.SMKTIsTeleporting == true or not hrp.Parent then break end
		local w = wps[i]
		local dv = w - hrp.Position
		local flat = Vector3.new(dv.X, 0, dv.Z)
		local last = i == #wps
		if flat.Magnitude <= (last and 2.5 or 2) and (not last or math.abs(dv.Y) < 6) then
			i += 1
		else
			if dv.Y > 2 then
				local st = hum:GetState()
				if st ~= Enum.HumanoidStateType.Jumping and st ~= Enum.HumanoidStateType.Freefall then hum.Jump = true end
			end
			local rem = flat.Magnitude
			for k = i + 1, #wps do rem += (wps[k] - wps[k - 1]).Magnitude end
			local s = math.clamp(rem * 14, 40, spd)
			local u = flat.Magnitude > 0.05 and flat.Unit or Vector3.zero
			hrp.AssemblyLinearVelocity = u * s + Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
			hrp.AssemblyAngularVelocity = Vector3.zero
			HB:Wait()
		end
	end
	if hrp.Parent then
		hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
		hrp.AssemblyAngularVelocity = Vector3.zero
	end
	if flew and cfA then pcall(cfA.stop) end
	return how .. " " .. #wps .. "wp" .. (flew and " flight" or " no flight")
end

local function parseValueFromText(str)
	if type(str) ~= "string" or str == "" then return nil end
	local s = str:gsub("%$",""):gsub("%+",""):gsub(" ",""):gsub(",","."):lower()
	local numStr, unit = s:match("([%d%.]+)%s*([kmbtq]?)/?s?")
	if numStr then
		local n = tonumber(numStr)
		if n then
			unit = (unit or ""):upper()
			if unit == "K" then n = n * 1e3
			elseif unit == "M" then n = n * 1e6
			elseif unit == "B" then n = n * 1e9
			elseif unit == "T" then n = n * 1e12
			elseif unit == "Q" then n = n * 1e15 end
			return n
		end
	end
	return nil
end

local function getPetTraits(petObj)
	if not petObj or not petObj:IsA("Model") then return {} end
	local traits = {}
	local seen = {}
	local function addTrait(raw)
		if type(raw) ~= "string" or raw == "" then return end
		local clean = raw:match("^%s*(.-)%s*$")
		if not clean or clean == "" then return end
		local lower = clean:lower()
		if #clean < 2 or tonumber(clean) then return end
		if not seen[lower] then
			seen[lower] = true
			table.insert(traits, clean)
		end
	end

	for _, child in ipairs(petObj:GetChildren()) do
		local traitName = child.Name:match("^_Trait%.(.+)$")
		if traitName then addTrait(traitName) end
	end

	local hasFire = false
	for _, desc in ipairs(petObj:GetDescendants()) do
		if desc:IsA("ParticleEmitter") and desc.Name == "FireSpecs" then
			hasFire = true
			break
		end
	end

	for _, child in ipairs(petObj:GetChildren()) do
		if child.Name == "_VfxInstance" or child.Name == "VfxInstance" then
			for _, pe in ipairs(child:GetChildren()) do
				if pe:IsA("ParticleEmitter") then
					local pname = pe.Name
					if pname == "FireSpecs" then addTrait("Fire")
					elseif pname == "TacosRotate" or pname == "TacosRegular" then addTrait("Taco")
					elseif pname == "purplespace" or pname == "bluespace" or pname == "bluerspace" then addTrait("Galactic")
					elseif pname == "Pixel Star 2" then addTrait("Indonesia")
					elseif pname == "Pixel Star 3" and not hasFire then addTrait("Snowy")
					end
				end
			end
		end
	end
	return traits
end

local function getPetMutation(petObj)
	if not petObj then return "None" end
	local raw = petObj:GetAttribute("Mutation") or petObj:GetAttribute("__mutation")
	if not raw then
		local mObj = petObj:FindFirstChild("Mutation")
		if mObj and mObj:IsA("StringValue") then raw = mObj.Value end
	end
	if not raw then
		for _, child in ipairs(petObj:GetChildren()) do
			local mutName = child.Name:match("^_Mutation%.(.+)$")
			if mutName then raw = mutName; break end
		end
	end
	if type(raw) == "string" and raw ~= "" and raw ~= "None" then
		return raw
	end
	return "None"
end

local function getLiveGenDetails(petObj, podiumObj)
	local bestVal = 0
	local roots = {}
	if petObj then table.insert(roots, petObj) end
	if podiumObj then table.insert(roots, podiumObj) end
	for _, root in ipairs(roots) do
		for _, desc in ipairs(root:GetDescendants()) do
			if desc:IsA("BillboardGui") or desc:IsA("SurfaceGui") then
				for _, label in ipairs(desc:GetDescendants()) do
					if label:IsA("TextLabel") and label.Visible ~= false then
						local txt = label.Text
						if txt and txt ~= "" then
							local lower = txt:lower()
							if (lower:find("/s") or lower:find("cps"))
								and not lower:find("upgrade")
								and not lower:find("buy")
								and not lower:find("lvl")
								and not lower:find("cost")
								and not lower:find("price")
								and not lower:find("req") then
								local parsed = parseValueFromText(txt)
								if parsed and parsed > bestVal then
									bestVal = parsed
								end
							end
						end
					end
				end
			end
		end
	end
	return bestVal
end

local function _sabCalcGen(idx, mut, traits, petObj, podiumObj)
	local liveVal = getLiveGenDetails(petObj, podiumObj)
	if liveVal and liveVal > 0 then
		return liveVal
	end

	local base = 0
	if AnimalsData and AnimalsData[idx] then
		base = tonumber(AnimalsData[idx].Generation or AnimalsData[idx].BaseGeneration) or 0
	end

	local petMut = (mut and mut ~= "None") and mut or getPetMutation(petObj)
	local petTraits = (type(traits) == "table" and #traits > 0) and traits or getPetTraits(petObj)

	local mult = 1
	if petMut and petMut ~= "None" and MutationsData then
		local m = MutationsData[petMut]
		if type(m) == "table" then
			mult = mult + (tonumber(m.Modifier or m.MultiplierModifier or m.Multiplier) or 0)
		end
	end

	if type(petTraits) == "table" and TraitsData then
		for _, t in ipairs(petTraits) do
			local tr = TraitsData[t]
			if not tr then
				for _, v in pairs(TraitsData) do
					if type(v) == "table" and (v.DisplayName or v.Display or v.Name or ""):lower() == tostring(t):lower() then
						tr = v
						break
					end
				end
			end
			if type(tr) == "table" then
				mult = mult + (tonumber(tr.MultiplierModifier or tr.Modifier or tr.Multiplier or tr.Boost) or 0)
			end
		end
	end

	return math.floor(base * mult + 0.5)
end

local BANNED_PET_NAMES = {
	["noobini pizzanini"] = true,
	["queen bee"] = true,
}

local function _isBannedPet(name)
	if not name then return false end
	local k = tostring(name):lower():gsub("%s+", " ")
	return BANNED_PET_NAMES[k] == true
end

local function _passesMinGen(genValue)
	local minMillions = tonumber(Hub.State.minGenMillions) or 0
	if minMillions <= 0 then return true end
	local gen = tonumber(genValue) or 0
	return gen >= (minMillions * 1000000)
end

