local _FLY = {}
function _FLY.segHitsPart(a, b, part, ix, iy)
    local cf, sz = part.CFrame, part.Size
    local la = cf:PointToObjectSpace(a)
    local lb = cf:PointToObjectSpace(b)
    local d = lb - la
    local tmin, tmax = 0, 1
    local axes = {
        { la.X, d.X, sz.X * 0.5 + ix },
        { la.Y, d.Y, sz.Y * 0.5 + iy },
        { la.Z, d.Z, sz.Z * 0.5 + ix },
    }
    for _, ax in ipairs(axes) do
        local o, dd, h = ax[1], ax[2], ax[3]
        if math.abs(dd) < 1e-6 then
            if o < -h or o > h then return false end
        else
            local t1 = (-h - o) / dd
            local t2 = (h - o) / dd
            if t1 > t2 then t1, t2 = t2, t1 end
            if t1 > tmin then tmin = t1 end
            if t2 < tmax then tmax = t2 end
            if tmin > tmax then return false end
        end
    end
    return true
end
function _FLY.stepRoute(fromPos, route)
    local STEP = 10
    local out = {}
    local prev = fromPos
    for _, wp in ipairs(route) do
        local dy = wp.Y - prev.Y
        if dy > STEP * 1.5 then
            local n = math.ceil(dy / STEP)
            for s = 1, n - 1 do
                local t = s / n
                out[#out + 1] = Vector3.new(prev.X + (wp.X - prev.X) * t, prev.Y + dy * t, prev.Z + (wp.Z - prev.Z) * t)
            end
        end
        out[#out + 1] = wp
        prev = wp
    end
    return out
end
function _FLY.streamAhead(a, b)
    if not (a and b) then return end
    local d = (b - a).Magnitude
    local n = math.clamp(math.floor(d / 80), 1, 6)
    local left = n
    for i = 1, n do
        local p = a:Lerp(b, i / n)
        task.spawn(function()
            pcall(function() LP:RequestStreamAroundAsync(p, 1) end)
            left -= 1
        end)
    end
    local t0 = os.clock()
    local sw = tonumber(_G.TT3StreamWait) or 0
    if os.clock() - (tonumber(_G.SMKT_LoadClock) or 0) < 25 then sw = math.max(sw, 0.8) end
    while left > 0 and os.clock() - t0 < sw do RunService.Heartbeat:Wait() end
end
function _FLY.replan(cur, legs, facing, preferCrest)
    local route = {}
    local startIdx = 1
    if #legs >= 2 then
        local dest, entry = legs[#legs], legs[#legs - 1]
        if (cur - dest).Magnitude < (entry - dest).Magnitude then startIdx = #legs end
    end
    local from = cur
    for i = startIdx, #legs do
        local seg = computeRoute(from, legs[i], facing, nil, preferCrest)
        if not seg or #seg == 0 then seg = computeRoute(from, legs[i], nil, nil, preferCrest) end
        if not seg or #seg == 0 then seg = { legs[i] } end
        for _, p in ipairs(seg) do
            if #route == 0 or (route[#route] - p).Magnitude > 0.5 then route[#route + 1] = p end
        end
        from = legs[i]
    end
    return route
end
function _FLY.fly(hrp, pts, speed, routeMode, legs, facing, preferCrest)
    local replans = 0
    while true do
        local runId = _tpRun
        local blocked = false
        local char = LP.Character
        local function check(part)
            if blocked or not part or not part.Parent or not hrp or not hrp.Parent then return end
            if not part:IsA("BasePart") or not part.CanCollide then return end
            if char and part:IsDescendantOf(char) then return end
            local nm = part.Name
            if nm == "LaserHitbox" or nm == "Laser" or string.find(nm, "Platform", 1, true) then return end
            local m = part:FindFirstAncestorWhichIsA("Model")
            if m and m:FindFirstChildOfClass("Humanoid") then return end
            local prog = _G.__SMKT_VMWp
            if not prog or prog.run ~= runId then return end
            local wps = prog.wps
            local a = hrp.Position
            for i = prog.idx, #wps do
                local b = wps[i]
                if i == #wps then
                    local seg = b - a
                    local L = seg.Magnitude
                    if L <= 12 then return end
                    b = a + seg.Unit * (L - 12)
                end
                if _FLY.segHitsPart(a, b, part, math.max(3.5, math.min(tonumber(_G.TT3CarpetFootLast) or 0, 6) + 0.75), 3.5) then
                    blocked = true
                    _G.__SMKT_VMAbort = runId
                    return
                end
                a = wps[i]
            end
        end
        local conn = workspace.DescendantAdded:Connect(function(d)
            if not blocked and d:IsA("BasePart") then task.defer(check, d) end
        end)
        _G.__SMKT_FlyNoSnap = (replans < 3) and runId or nil
        velMoveThrough(hrp, pts, speed, true, true, routeMode)
        _G.__SMKT_FlyNoSnap = nil
        pcall(function() conn:Disconnect() end)
        if _G.__SMKT_VMAbort == runId then _G.__SMKT_VMAbort = nil end
        local prog = _G.__SMKT_VMWp
        local stalled = prog ~= nil and prog.run == runId and prog.stalled == true
        if not (blocked or stalled) or replans >= 3 or _G.TT3TPStop or _tpRun ~= runId or not hrp.Parent then return end
        replans += 1
        if hrp.Parent then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
        local route = _FLY.replan(hrp.Position, legs, facing, preferCrest)
        pts = _FLY.stepRoute(hrp.Position, route)
    end
end

local function _tpRecheck(pet)
    if type(pet) ~= "table" or pet.plot == nil or pet.slot == nil then return pet end
    local ch = getPlotChannel(tostring(pet.plot))
    local al = ch and channelGet(ch, "AnimalList")
    if type(al) ~= "table" then return pet end
    local n = tonumber(pet.slot)
    local e = n and (rawget(al, n) or rawget(al, tostring(n))) or nil
    if type(e) == "table" and e.Index ~= nil then return pet end
    local ok, pets = pcall(scanForTP)
    if ok and type(pets) == "table" then
        for _, p in ipairs(pets) do
            if tostring(p.plot) == tostring(pet.plot) and not p.beingStolen and typeof(p.position) == "Vector3" then return p end
        end
    end
    return pet
end

