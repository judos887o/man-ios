			invis = inv,
		}
		local ok, js = pcall(function() return HttpService:JSONEncode(data) end)
		if not ok or type(js) ~= "string" then return false end
		local s = "SMKT1:" .. js
		cfgBox.Text = s
		local clip = (type(setclipboard) == "function" and setclipboard) or (type(toclipboard) == "function" and toclipboard) or nil
		if clip then return (pcall(clip, s)) end
		return false
	end
	local function cfgApply(text)
		text = tostring(text or "")
		text = string.gsub(text, "^%s+", "")
		text = string.gsub(text, "%s+$", "")
		local js = string.match(text, "^SMKT1:(.*)$") or text
		local ok, cfg = pcall(function() return HttpService:JSONDecode(js) end)
		if not ok or type(cfg) ~= "table" or (cfg.smkt == nil and cfg.hub == nil and cfg.mini == nil) then return false end
		if type(cfg.hub) == "table" then
			for k, v in pairs(cfg.hub) do
				if k == "priorityList" then
					if type(v) == "table" then
						local pl = Hub.State.priorityList
						if type(pl) ~= "table" then pl = {}; Hub.State.priorityList = pl end
						table.clear(pl)
						for _, n in ipairs(v) do if type(n) == "string" then pl[#pl + 1] = n end end
					end
				else
					Hub.State[k] = v
				end
			end
			SaveState(Hub.State)
			AG_State.Active = Hub.State.agActive == true
			if type(_G.SMKT_RebuildPriority) == "function" then pcall(_G.SMKT_RebuildPriority) end
			pcall(setTarget, type(Hub.State.toggles) ~= "table" or Hub.State.toggles["StealTargetGUI"] ~= false)
		end
		if type(cfg.mini) == "table" then
			for k, v in pairs(cfg.mini) do M[k] = v end
			if type(M.xray) ~= "number" then M.xray = 50 end
			_G.SMKTXrayAlpha = math.clamp(M.xray, 0, 90) / 100
			if _G.SMKTXrayRepaint then pcall(_G.SMKTXrayRepaint) end
			getgenv().SMKT_BaseESP = M.baseEsp == true
			getgenv().SMKT_RotESP = M.rotEsp == true
			_G.MeerkoAutoKickOnSteal = M.autoKick == true
			getgenv().SMKT_AntiRagdollOn = M.antiRagdoll == true
			getgenv().SMKT_AntiKnockbackOn = M.antiKnockback == true
			if type(_G.SMKT_SetAntiRagdoll) == "function" then pcall(_G.SMKT_SetAntiRagdoll, M.antiRagdoll == true) end
			if type(_G.SMKT_SetAntiKnockback) == "function" then pcall(_G.SMKT_SetAntiKnockback, M.antiKnockback == true) end
			if type(_G.SMKTMini_SetMovement) == "function" then pcall(_G.SMKTMini_SetMovement, M.movement ~= false) end
			pcall(TurretESP.set, M.turretEsp ~= false)
			if type(M.guiScale) ~= "number" then M.guiScale = 100 end
			if _G.SMKT_SetGuiScale then _G.SMKT_SetGuiScale(M.guiScale) end
			_G.SMKTFlashWait = tonumber(M.flashWait) or 0
			_G.SMKTGrappleAfterSwap = M.swapGrapple ~= false
			if type(M.buyMinGen) ~= "number" then M.buyMinGen = 0 end
			panel.Visible = M.visible ~= false
			if pages[M.tab] then selectTab(M.tab) end
			saveMini()
		end
		if type(cfg.tp) == "table" then
			for k, v in pairs(cfg.tp) do T[k] = v end
			T.tool = (type(T.tool) == "string" and T.tool ~= "") and T.tool or "Waverider"
			T.tpSpeed = math.clamp(math.floor(tonumber(T.tpSpeed) or 480), 80, 750)
			T.walkSpeed = math.clamp(math.floor(tonumber(T.walkSpeed) or 400), 20, 1000)
			T.landing = math.clamp(tonumber(T.landing) or 0.15, 0.05, 0.75)
			T.closeSpeed = math.clamp(math.floor(tonumber(T.closeSpeed) or 80), 20, 750)
			T.tpMode = (T.tpMode == "Flash") and "Flash" or "Clone"
			saveTp()
			pushTp()
			pcall(paintCarpet)
			pcall(paintTpMode)
		end
		if type(cfg.invis) == "table" then
			pcall(function()
				if writefile then writefile(INVIS_FILE, HttpService:JSONEncode(cfg.invis)) end
			end)
			local iv = cfg.invis
