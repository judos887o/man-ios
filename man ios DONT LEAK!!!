	local function _modeBetter(a, b, hrp, priMap)
		if AG_State.Mode == "Nearest" then
			local pa, pb = _promptPos(a.prompt), _promptPos(b.prompt)
			local da = pa and (hrp.Position - pa).Magnitude or math.huge
			local db = pb and (hrp.Position - pb).Magnitude or math.huge
			return da < db
		end
		local ra = priMap[_normName(a.name)] or priMap[_normName(a.index)]
		local rb = priMap[_normName(b.name)] or priMap[_normName(b.index)]
		if ra and rb then if ra ~= rb then return ra < rb end
		elseif ra then return true
		elseif rb then return false end
		if a.gen ~= b.gen then return a.gen > b.gen end
		return a.uid < b.uid
	end

	local _useHitbox = true
	local _selDistNow = nil
	local function _pick(hrp)
		local radius = _agRadius()
		local sel = getgenv().SMKT_SelectedData
		local manual = getgenv().SMKT_ManualPin == true and type(sel) == "table"
		local priMap = _buildPriMap()
		local selC, bestReach, bestNear, sameReach, sameNear
		local now = os.clock()
		local selPlot = type(sel) == "table" and sel.plot ~= nil and tostring(sel.plot) or nil
		local selSlot = type(sel) == "table" and tonumber(tostring(sel.slot or ""):match("%d+")) or nil
		local lockC
		local tpOn = _G.SMKTIsTeleporting == true or _G.TT3StealHold == true
		local tpT = _G.SMKTTPTarget
		if not manual and type(tpT) == "table" and tpT.plot ~= nil and tonumber(tpT.slot) and now - (tonumber(tpT.at) or -math.huge) < (tpOn and 20 or 30)
			and (tonumber(getgenv().SMKT_SelAt) or -math.huge) <= (tonumber(tpT.at) or 0) then
			selPlot, selSlot = tostring(tpT.plot), tonumber(tpT.slot)
			tpOn = true
		end
		_selDistNow = nil
		for _, c in ipairs(_cands) do
			local isSel = selPlot and selSlot == c.slot and (selPlot == c.plotName or selPlot == tostring(c.plot:GetAttribute("Order")))
			c.isSel = isSel and true or false
			if isSel then
				local sp = _promptPos(c.prompt)
				if sp then _selDistNow = (hrp.Position - sp).Magnitude end
			end
			if isSel and c.listed and c.beingStolen and c.prompt.Parent then lockC = c end
			if not _available(c.prompt) then continue end
			local pp = _promptPos(c.prompt)
			if not pp then continue end
			local d = (hrp.Position - pp).Magnitude
			c.dist = d
			local sb = _specBegin[c.uid]
			if sb and d > sb.d + 25 then _specBegin[c.uid] = nil end
			c.reach = d <= ST_REACH and (not _useHitbox or _hitboxOk(c.plot, hrp))
			local blocked = (_failUntil[c.uid] or 0) > now
			if isSel and not c.beingStolen and not blocked then selC = c end
			if blocked then continue end
			if selPlot and not isSel and (selPlot == c.plotName or selPlot == tostring(c.plot:GetAttribute("Order"))) then
				if c.reach and (not sameReach or _modeBetter(c, sameReach, hrp, priMap)) then sameReach = c end
				if d <= radius and (not sameNear or _modeBetter(c, sameNear, hrp, priMap)) then sameNear = c end
				continue
			end
			if c.reach and (not bestReach or _modeBetter(c, bestReach, hrp, priMap)) then bestReach = c end
			if d <= radius and (not bestNear or _modeBetter(c, bestNear, hrp, priMap)) then bestNear = c end
		end
		if not selC and not lockC and not manual then
			if sameReach and (not bestReach or _modeBetter(sameReach, bestReach, hrp, priMap)) then bestReach = sameReach end
			if sameNear and (not bestNear or _modeBetter(sameNear, bestNear, hrp, priMap)) then bestNear = sameNear end
		end
		local selLim = tpOn and 3000 or radius
		if not manual and selPlot and selSlot and _selDistNow and _selDistNow <= math.max(radius, selLim) + 40 then
			if selC and (selC.reach or selC.dist <= math.max(radius, selLim)) then return selC end
			if lockC then return lockC end
			return nil, "waiting for selected target"
		end
		if manual then
			if selC and selC.dist <= math.max(radius, selLim) then return selC end
			if lockC and not selC then return lockC end
			return nil, selC and ("target too far: " .. math.floor(selC.dist) .. " studs") or "target not available"
		end
		if AG_State.Mode ~= "Nearest" then
			if lockC and not selC then
				local lp = _promptPos(lockC.prompt)
				if lp and (hrp.Position - lp).Magnitude <= math.max(radius, selLim) then
					return lockC
				end
			end
			if selC and (selC.reach or selC.dist <= selLim) then return selC end
		end
		if selC and selC.reach then return selC end
		if bestReach then return bestReach end
		if selC and selC.dist <= selLim then return selC end
		if bestNear then return bestNear end
		return nil, "no brainrot in range"
	end

